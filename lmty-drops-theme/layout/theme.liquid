<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#e39617">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}<link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}">{%- endif -%}
  <title>{{ page_title }}{% if current_page != 1 %} &ndash; {{ current_page }}{% endif %}{% assign bn = settings.brand_name | default: 'LMTY' %}{% unless page_title contains bn %} &ndash; {{ bn }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  {{ 'steep.css' | asset_url | stylesheet_tag }}
</head>
<body class="no-js template-{{ template.name | handle }}">
  {% render 'site-header' %}
  <script>document.body.classList.remove("no-js")</script>
  <main id="content" tabindex="-1">{{ content_for_layout }}</main>
  {% render 'site-footer' %}
  {% render 'cart-drawer' %}
  <script type="application/json" data-money-format>{{ shop.money_format | json }}</script>
  <script src="{{ 'steep.js' | asset_url }}" defer></script>
</body>
</html>
