{% schema %}
{
  "name": "Steep landing",
  "settings": [
    {"type": "checkbox", "id": "show_hero", "label": "Show hero + proof strip", "default": true},
    {"type": "checkbox", "id": "classic", "label": "Classic (shorter) layout", "default": false},
    {"type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Square product shot. Falls back to the product's first image."},
    {"type": "product", "id": "product", "label": "Product (home page only)"},
    {"type": "text", "id": "comments_eyebrow", "label": "Comments: eyebrow", "default": "From our Facebook ad comments"},
    {"type": "text", "id": "comments_title", "label": "Comments: heading", "default": "Don't take our word for it. Ask the comments."},
    {"type": "text", "id": "comments_lead", "label": "Comments: intro", "default": "Every time someone asks a question under our ads, the answers come from people who already tried it."},
    {"type": "header", "content": "Bundle perks (only promise what you ship)"},
    {"type": "text", "id": "perk_1", "label": "Perk on every bundle above 1 bottle", "default": "Free Express Shipping"},
    {"type": "text", "id": "perk_2", "label": "Extra perk on the biggest bundle", "default": "Free Mystery Gift"},
    {"type": "text", "id": "perk_3", "label": "Second extra perk on the biggest bundle", "default": "Free Shipping Protection"},
    {"type": "text", "id": "sale_label", "label": "Label before SAVE % (e.g. Fall Sale)", "default": "Fall Sale"},
    {"type": "text", "id": "unit_3", "label": "Buy 2 Get 1 FREE price per bottle", "default": "13.99", "info": "Used when the product has no 3-bottle option."},
    {"type": "text", "id": "unit_6", "label": "Buy 3 Get 3 FREE price per bottle", "default": "10.99", "info": "Used when the product has no 6-bottle option."},
    {"type": "text", "id": "code_3", "label": "Discount code applied for Buy 2 Get 1 FREE", "default": "BUY2GET1", "info": "Create in Shopify Discounts so checkout matches: fixed amount = 3 x your 1-bottle price minus $41.97."},
    {"type": "text", "id": "code_6", "label": "Discount code applied for Buy 3 Get 3 FREE", "default": "BUY3GET3", "info": "Fixed amount = 6 x your 1-bottle price minus $65.94."},
    {"type": "number", "id": "delivery_days", "label": "Business days to delivery (for the delivery date)", "default": 5},
    {"type": "header", "content": "Rating badge (real numbers only)"},
    {"type": "text", "id": "rating_value", "label": "Average rating (e.g. 4.8)", "info": "Copy from your review app. Leave blank to hide."},
    {"type": "number", "id": "rating_count", "label": "Number of reviews"},
    {"type": "text", "id": "rating_source", "label": "Where the reviews are from (e.g. Judge.me)"},
    {"type": "html", "id": "trustbox", "label": "Trustpilot TrustBox code", "info": "Paste the TrustBox snippet from your Trustpilot business account."},
    {"type": "number", "id": "review_count", "label": "Order count shown next to rating", "default": 1000}
  ],
  "blocks": [
    {"type": "ingredient", "name": "Blend ingredient", "settings": [
      {"type": "text", "id": "title", "label": "Name", "default": "Green Tea"},
      {"type": "text", "id": "text", "label": "One-line description"},
      {"type": "image_picker", "id": "image", "label": "Cut-out photo (transparent PNG)"},
      {"type": "select", "id": "art", "label": "Illustration if no photo", "default": "green-tea", "options": [
        {"value": "green-tea", "label": "Green tea"}, {"value": "lemon-verbena", "label": "Lemon verbena"},
        {"value": "spearmint", "label": "Spearmint"}, {"value": "honey", "label": "Honey"}]}
    ]}
  ,
    {"type": "review", "name": "Customer review", "settings": [
      {"type": "paragraph", "content": "Add real reviews from verified buyers only."},
      {"type": "text", "id": "name", "label": "Name (first name + initial)", "default": "Name"},
      {"type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5},
      {"type": "text", "id": "title", "label": "Headline"},
      {"type": "textarea", "id": "text", "label": "Review"}
    ]},
    {"type": "comment", "name": "Ad comment", "settings": [
      {"type": "paragraph", "content": "Paste a real comment from your ads, word for word. Level 0 starts a new thread; 1 and 2 are replies under it."},
      {"type": "text", "id": "name", "label": "Commenter name (first name + initial)", "default": "Name"},
      {"type": "select", "id": "level", "label": "Level", "default": "0", "options": [{"value": "0", "label": "Top comment"}, {"value": "1", "label": "Reply"}, {"value": "2", "label": "Reply to reply"}]},
      {"type": "text", "id": "reply_to", "label": "Replying to (name, optional)"},
      {"type": "textarea", "id": "text", "label": "Comment text"},
      {"type": "text", "id": "age", "label": "Age label", "default": "1w"},
      {"type": "number", "id": "likes", "label": "Reactions", "default": 0}
    ]}
  ],
  "presets": [{"name": "Steep landing"}]
}
{% endschema %}
