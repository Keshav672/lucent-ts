{%- assign support_email = settings.support_email | default: shop.email -%}
<section class="contact-page">
  <div class="wrap contact-page__grid">
    <div class="contact-page__intro">
      <p class="eyebrow">Contact Lucent</p>
      <h1>{{ page.title | default: 'Contact us' }}</h1>
      <p class="contact-page__lead">Questions about Nattokinase 4-in-1, ingredients, your order, or the product label? Send us a note and our team will get back to you.</p>
      {% if page.content != blank %}
        <div class="rte contact-page__content">{{ page.content }}</div>
      {% endif %}
      <div class="contact-page__details">
        <div><strong>Email</strong><a href="mailto:{{ support_email }}">{{ support_email }}</a></div>
        <div><strong>Typical reply time</strong><span>1–2 business days</span></div>
      </div>
    </div>

    <div class="contact-card">
      {% form 'contact', id: 'ContactForm' %}
        {% if form.posted_successfully? %}
          <div class="contact-alert contact-alert--success" tabindex="-1" autofocus>
            Thanks. Your message was sent, we'll be in touch soon.
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="contact-alert contact-alert--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="contact-fields contact-fields--two">
          <label class="contact-field">
            <span>Name</span>
            <input type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="Your name">
          </label>
          <label class="contact-field">
            <span>Email <em>*</em></span>
            <input type="email" name="contact[email]" autocomplete="email" autocorrect="off" autocapitalize="off" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" placeholder="you@example.com">
          </label>
        </div>

        <label class="contact-field">
          <span>Phone <small>(optional)</small></span>
          <input type="tel" name="contact[phone]" autocomplete="tel" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="(555) 555-5555">
        </label>

        <label class="contact-field">
          <span>What can we help with? <em>*</em></span>
          <textarea rows="7" name="contact[body]" required placeholder="Tell us what's going on…">{{ form.body }}</textarea>
        </label>

        <button type="submit" class="btn btn--block btn--lg">Send message</button>
        <p class="contact-card__note">By submitting, you're asking Lucent to respond to this request using the contact details above.</p>
      {% endform %}
    </div>
  </div>
</section>
