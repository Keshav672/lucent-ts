<section class="simple-page"><div class="wrap simple-page__article"><p class="eyebrow">Find something</p><h1>Search Lucent</h1><form action="{{ routes.search_url }}" method="get" class="search-form"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search" aria-label="Search"><button type="submit" class="btn">Search</button></form>{% if search.performed %}<p class="search-count">{{ search.results_count }} results</p><div class="search-results">{% for item in search.results %}<a href="{{ item.url }}">{{ item.title }}</a>{% endfor %}</div>{% endif %}</div></section>
