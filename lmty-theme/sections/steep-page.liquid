{% schema %}
{
  "name": "Steep landing",
  "settings": [
    {"type": "checkbox", "id": "show_hero", "label": "Show hero + proof strip", "default": true},
    {"type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Square product shot. Falls back to the product's first image."},
    {"type": "product", "id": "product", "label": "Product (home page only)"},
    {"type": "text", "id": "comments_eyebrow", "label": "Comments: eyebrow", "default": "From our Facebook ad comments"},
    {"type": "text", "id": "comments_title", "label": "Comments: heading", "default": "Don't take our word for it. Ask the comments."},
    {"type": "text", "id": "comments_lead", "label": "Comments: intro", "default": "Every time someone asks a question under our ads, the answers come from people who already tried it."},
    {"type": "number", "id": "review_count", "label": "Order count shown next to rating", "default": 1000}
  ],
  "blocks": [
    {"type": "ingredient", "name": "Blend ingredient", "settings": [
      {"type": "text", "id": "title", "label": "Name", "default": "Green Tea"},
      {"type": "text", "id": "text", "label": "One-line description"},
      {"type": "image_picker", "id": "image", "label": "Cut-out photo (transparent PNG)"},
      {"type": "select", "id": "art", "label": "Illustration if no photo", "default": "green-tea", "options": [
        {"value": "green-tea", "label": "Green tea"}, {"value": "lemon-verbena", "label": "Lemon verbena"},
        {"value": "spearmint", "label": "Spearmint"}, {"value": "honey", "label": "Honey"}]}
    ]}
  ,
    {"type": "comment", "name": "Ad comment", "settings": [
      {"type": "paragraph", "content": "Paste a real comment from your ads, word for word. Level 0 starts a new thread; 1 and 2 are replies under it."},
      {"type": "text", "id": "name", "label": "Commenter name (first name + initial)", "default": "Name"},
      {"type": "select", "id": "level", "label": "Level", "default": "0", "options": [{"value": "0", "label": "Top comment"}, {"value": "1", "label": "Reply"}, {"value": "2", "label": "Reply to reply"}]},
      {"type": "text", "id": "reply_to", "label": "Replying to (name, optional)"},
      {"type": "textarea", "id": "text", "label": "Comment text"},
      {"type": "text", "id": "age", "label": "Age label", "default": "1w"},
      {"type": "number", "id": "likes", "label": "Reactions", "default": 0}
    ]}
  ],
  "presets": [{"name": "Steep landing"}]
}
{% endschema %}
