{%- assign p = product -%}
{%- if p == blank -%}{%- assign p = section.settings.product -%}{%- endif -%}
{%- if p == blank -%}{%- assign p = settings.featured_product -%}{%- endif -%}
{%- if p == blank -%}{%- assign p = all_products['lmty-honey-citrus-mint-ball'] -%}{%- endif -%}
{%- assign v = p.selected_or_first_available_variant -%}
{%- assign own = false -%}{%- if p.title contains 'LMTY' or p.title contains 'Citrus Mint' -%}{%- assign own = true -%}{%- endif -%}
{%- assign has_plans = false -%}{%- if p.selling_plan_groups.size > 0 -%}{%- assign has_plans = true -%}{%- endif -%}
{%- assign reviews_n = section.settings.review_count -%}

{%- if section.settings.show_hero -%}
<section class="hero">
  <div class="wrap hero__in">
    <div>
      <p class="eyebrow" style="color:var(--honey)">Honey · Citrus · Mint</p>
      <h1 class="hero__h">Café-style comfort. <em>Made at home.</em></h1>
      <p class="hero__lead">Bright citrus, cool mint, smooth green tea and honey sweetness in an easy-to-prepare concentrate. Enjoy it warm or iced, without the long line.</p>
      <ul class="chips"><li>32 oz concentrate</li><li>Green tea</li><li>Hot or iced</li><li>About 8 cups</li></ul>
      <div class="hero__row">
        <a href="#buy" class="btn btn--lg btn--light">Add to cart · {{ v.price | money }}</a>
        <a href="#buy" class="btn btn--lg btn--outline">Choose your pack</a>
      </div>
      <p class="hero__note">Free shipping on every order · Ships from the US</p>
    </div>
    <div class="hero__media hero__media--img">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1100 }}" alt="{{ section.settings.hero_image.alt | default: 'LMTY Honey Citrus Mint Ball green tea concentrate' | escape }}" width="1100" height="1100" fetchpriority="high">
            {%- else -%}
        <img src="{{ 'lmty-carton.jpg' | asset_url }}" alt="LMTY Honey Citrus Mint Ball green tea concentrate" width="1024" height="1024" fetchpriority="high">
      {%- endif -%}
    </div>
  </div>
</section>
<div class="proof">
  <div class="wrap proof__in">
    <div class="proof__i"><div class="proof__n">1,000+</div><div class="proof__l">cartons sold this season</div></div>
    <div class="proof__i"><div class="proof__n">32 oz</div><div class="proof__l">concentrate per carton</div></div>
    <div class="proof__i"><div class="proof__n">2 min</div><div class="proof__l">from carton to mug</div></div>
    <div class="proof__i"><div class="proof__n">$0</div><div class="proof__l">shipping, every order</div></div>
  </div>
</div>
{%- endif -%}

<section class="buy" id="buy">
  <div class="wrap buy__in">
    <div class="gal" data-gallery>
      <div class="gal__main">
        {%- if own and p.media.size > 0 -%}
          {%- for m in p.media -%}{%- if m.media_type == 'image' -%}
          <img src="{{ m | image_url: width: 1100 }}" alt="{{ m.alt | default: p.title | escape }}" width="1100" height="1100" data-slide{% unless forloop.first %} hidden loading="lazy"{% endunless %}>
          {%- endif -%}{%- endfor -%}
        {%- else -%}
          <img src="{{ 'lmty-carton.jpg' | asset_url }}" alt="LMTY Honey Citrus Mint Ball 32 oz green tea concentrate carton" width="1024" height="1024" data-slide>
          <img src="{{ 'lmty-ingredients.jpg' | asset_url }}" alt="Ingredients: lemon verbena, lemongrass, peach flavor, citrus flavor, spearmint and honey" width="1024" height="1024" data-slide hidden loading="lazy">
          <img src="{{ 'gif-glass.gif' | asset_url }}" alt="A warm glass of honey citrus mint tea" width="300" height="400" data-slide hidden loading="lazy">
        {%- endif -%}
        <button type="button" class="gal__nav gal__nav--p" aria-label="Previous image" data-prev>&lsaquo;</button>
        <button type="button" class="gal__nav gal__nav--n" aria-label="Next image" data-next>&rsaquo;</button>
      </div>
      <div class="gal__thumbs" data-thumbs>
        {%- if own and p.media.size > 0 -%}
          {%- for m in p.media -%}{%- if m.media_type == 'image' -%}
          <button type="button" aria-label="Show image {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}><img src="{{ m | image_url: width: 160 }}" alt="" width="72" height="72" loading="lazy"></button>
          {%- endif -%}{%- endfor -%}
        {%- else -%}
          <button type="button" aria-label="Show image 1" aria-current="true"><img src="{{ 'lmty-carton.jpg' | asset_url }}" alt="" width="72" height="72" loading="lazy"></button>
          <button type="button" aria-label="Show image 2"><img src="{{ 'lmty-ingredients.jpg' | asset_url }}" alt="" width="72" height="72" loading="lazy"></button>
          <button type="button" aria-label="Show image 3"></button>
          <button type="button" aria-label="Show image 3"><img src="{{ 'gif-glass.gif' | asset_url }}" alt="" width="72" height="72" loading="lazy"></button>
          {%- endif -%}
      </div>
    </div>

    <div>
      <a href="#reviews" class="buy__rating">{{ reviews_n }}+ cartons sold</a>
      {%- if section.settings.show_hero -%}<h2 class="buy__t">{% if own %}{{ p.title }}{% else %}LMTY Honey Citrus Mint Ball{% endif %}</h2>{%- else -%}<h1 class="buy__t">{% if own %}{{ p.title }}{% else %}LMTY Honey Citrus Mint Ball{% endif %}</h1>{%- endif -%}
      <p class="buy__sub">Green tea, honey, citrus, mint and a hint of peach. Mix 1:1 with water for a cozy café-style cup, warm or iced.</p>
      <ul class="ticks">
        <li>Tastes just as good as the café version</li>
        <li>One carton makes cups for the whole week</li>
        <li>Drink it hot or iced</li>
      </ul>

      {%- form 'product', p, data-buy-form: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ v.id }}" data-variant-id>
        {%- unless p.has_only_default_variant -%}
        <fieldset class="opts">
          <legend class="opt-l">Size</legend>
          {%- for var in p.variants -%}
          <label class="opt">
            <input type="radio" name="steep-variant" value="{{ var.id }}" data-price="{{ var.price }}" data-compare="{{ var.compare_at_price | default: 0 }}"{% if var.id == v.id %} checked{% endif %}{% unless var.available %} disabled{% endunless %}>
            <span class="opt__b"><span class="opt__t">{{ var.title }}</span>{% unless var.available %}<span class="opt__s"> · Sold out</span>{% endunless %}</span>
            {%- assign n_cart = var.title | remove_first: 'Pack' | remove_first: 'pack' | strip | plus: 0 -%}
            <span class="opt__p">{{ var.price | money }}{% if n_cart > 1 %}<small class="opt__per">{{ var.price | divided_by: n_cart | money }} per carton</small>{% endif %}{% if var.compare_at_price > var.price %}<s>{{ var.compare_at_price | money }}</s>{% endif %}</span>
          </label>
          {%- endfor -%}
        </fieldset>
        {%- endunless -%}

        {%- if has_plans -%}
        {%- assign plan = p.selling_plan_groups.first.selling_plans.first -%}
        <fieldset class="opts" data-plans>
          <legend class="opt-l">Purchase type</legend>
          <label class="opt">
            <input type="radio" name="selling_plan" value="{{ plan.id }}" checked>
            <span class="opt__b"><span class="opt__t">Subscribe &amp; save <span class="tag">Best value</span></span><span class="opt__s">{{ plan.name }} · skip or cancel anytime</span></span>
          </label>
          <label class="opt">
            <input type="radio" name="selling_plan" value="">
            <span class="opt__b"><span class="opt__t">One-time purchase</span></span>
          </label>
        </fieldset>
        {%- endif -%}

        <div class="buy__qty">
          <div class="qty"><button type="button" aria-label="Decrease quantity" data-qty-minus>&minus;</button><input type="number" name="quantity" value="1" min="1" max="20" aria-label="Quantity" data-qty><button type="button" aria-label="Increase quantity" data-qty-plus>+</button></div>
          <button type="submit" class="btn btn--lg" data-add{% unless v.available %} disabled{% endunless %}>
            {%- if v.available -%}Add to cart · <span data-price-label>{{ v.price | money }}</span>{%- else -%}Sold out{%- endif -%}
          </button>
        </div>
        <p class="buy__msg" role="status" aria-live="polite" data-buy-msg></p>
      {%- endform -%}

      <div class="assure">
        <div><strong>Free shipping</strong>every order</div>
        <div><strong>Ships fast</strong>from the US</div>
        <div><strong>Secure checkout</strong>Shop Pay, Apple Pay</div>
      </div>

      <details class="acc" open><summary>How to make it</summary><div class="acc__b"><p>Hot: pour 1 part concentrate and 1 part water into a mug, microwave 60 to 90 seconds, stir.</p><p>Iced: pour over ice, top with cold water or lemonade.</p></div></details>
      <details class="acc"><summary>Ingredients</summary><div class="acc__b"><p>Green tea, lemon verbena, spearmint, lemongrass, honey, cane sugar, citric acid and natural flavors. Contains caffeine from green tea. Check the carton for the current full ingredient list.</p></div></details>
      <details class="acc"><summary>Size &amp; nutrition</summary><div class="acc__b"><p>32 fl oz (946 mL) carton, about 8 servings mixed 1:1. The Nutrition Facts panel is printed on the carton and shown in the product photos.</p></div></details>
      <details class="acc"><summary>Shipping &amp; returns</summary><div class="acc__b"><p>Free shipping on every order. Unopened cartons can be returned within 30 days of delivery.</p></div></details>
    </div>
  </div>
</section>

<section class="blend" id="blend">
  <div class="wrap">
    <h2 class="blend__h"><span>Know this</span> <em>amazing blend</em></h2>
    <p class="blend__lead">Four ingredients you can name. Here's exactly what goes into every pour.</p>
    <ul class="blend__list">
      {%- assign ing_n = 0 -%}{%- for b in section.blocks -%}{%- if b.type == 'ingredient' -%}{%- assign ing_n = ing_n | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if ing_n > 0 -%}
        {%- for b in section.blocks -%}{%- if b.type != 'ingredient' -%}{%- continue -%}{%- endif -%}
        <li class="blend__i" style="--d:{{ forloop.index0 | times: 120 }}ms" {{ b.shopify_attributes }}>
          <div class="blend__art">{%- if b.settings.image != blank -%}<img src="{{ b.settings.image | image_url: width: 320 }}" alt="{{ b.settings.title | escape }}" width="160" height="160" loading="lazy">{%- else -%}{% render 'blend-art', name: b.settings.art %}{%- endif -%}</div>
          <h3>{{ b.settings.title }}</h3><p>{{ b.settings.text }}</p>
        </li>
        {%- endfor -%}
      {%- else -%}
        {%- assign blend = 'green-tea|Green Tea|Smooth and lightly grassy, with a gentle lift.~lemon-verbena|Lemon Verbena|Bright, lemony and fresh, without the sour bite.~spearmint|Spearmint|Cool and fresh, the minty half of the magic.~honey|Honey|Honey sweetness that wraps it all together.' | split: '~' -%}
        {%- for x in blend -%}{%- assign bp = x | split: '|' -%}
        <li class="blend__i" style="--d:{{ forloop.index0 | times: 120 }}ms">
          <div class="blend__art">{% render 'blend-art', name: bp[0] %}</div>
          <h3>{{ bp[1] }}</h3><p>{{ bp[2] }}</p>
        </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

<section class="sec sec--green">
  <div class="wrap">
    <div class="sec__head">
      
      <h2 class="sec__h">Your new favorite tea ritual.</h2>
    </div>
    <div class="bens">
      <div class="ben"><h3>Café-style flavor</h3><p>The honey citrus mint combo you order out, without the drive or the $6 cup.</p></div>
      <div class="ben"><h3>Smells delicious</h3><p>Honey, citrus and mint hit you the second you pour. It tastes even better.</p></div>
      <div class="ben"><h3>Tucked in your pantry</h3><p>Keep a carton on hand so a cozy cup is always a few minutes away.</p></div>
      <div class="ben"><h3>Hot or iced</h3><p>Microwave it for a cozy mug or pour it over ice in summer. Same carton.</p></div>
    </div>
  </div>
</section>

<section class="sec" id="expect">
  <div class="wrap expect">
    <div>
      <div class="phone" data-expect-phone>
        <p class="phone__k">Your first carton</p>
        <p class="phone__t">About 8 cups, one pour at a time</p>
        <div class="cups" aria-hidden="true">{%- for i in (1..8) -%}<i></i>{%- endfor -%}</div>
        <p class="phone__foot"><strong data-expect-label>Day 1</strong><span data-expect-text>First cup. Half concentrate, half water.</span></p>
      </div>
    </div>
    <div>
      <p class="eyebrow">What to expect</p>
      <h2 class="sec__h">One carton. A week of cozy cups.</h2>
      <p class="sec__lead">No steeping, no tea bags, no measuring honey. Here's how a carton usually goes.</p>
      <ol class="tl" data-expect>
        <li data-cups="1" aria-current="true"><b>Day 1</b><span>First cup. Half concentrate, half water.</span></li>
        <li data-cups="3"><b>Day 3</b><span>You've worked out your ratio: a little stronger, or over ice.</span></li>
        <li data-cups="6"><b>Day 5</b><span>It's part of the evening routine now.</span></li>
        <li data-cups="8"><b>Day 7</b><span>Last pour. Time to restock, or grab the 2 pack next time.</span></li>
      </ol>
      <a href="#buy" class="btn btn--lg">Start your first carton</a>
    </div>
  </div>
</section>

<section class="sec sec--green">
  <div class="wrap">
    <h2 class="sec__h">Everything in the carton, printed on the front.</h2>
    <div class="specs">
      <div class="spec"><div class="spec__n">32 oz</div><h3>Concentrate</h3><p>946 mL, already brewed and sweetened.</p></div>
      <div class="spec"><div class="spec__n">~8</div><h3>Cups</h3><p>Mixed 1:1 with water, 8 oz each.</p></div>
      <div class="spec"><div class="spec__n">2 min</div><h3>Carton to mug</h3><p>Pour, add water, heat or ice.</p></div>
      <div class="spec"><div class="spec__n">1/5</div><h3>Caffeine level</h3><p>Light lift from green tea.</p></div>
    </div>
  </div>
</section>

<section class="sec" id="how">
  <div class="wrap">
    <div class="sec__head sec__head--c">
      <p class="eyebrow">How to make it</p>
      <h2 class="sec__h">Three steps. Two minutes.</h2>
      <p class="sec__lead">Concentrate means you make a cup in minutes, all week long.</p>
    </div>
    <div class="steps">
      <div class="step"><div class="step__m"><img src="{{ 'gif-overhead.gif' | asset_url }}" alt="Concentrate pouring into a mug" width="300" height="375" loading="lazy"></div><h3>Pour</h3><p>Fill your mug halfway with the concentrate.</p></div>
      <div class="step"><div class="step__m"><img src="{{ 'gif-pour.gif' | asset_url }}" alt="Hot water poured in and stirred" width="300" height="400" loading="lazy"></div><h3>Top up</h3><p>Add the same amount of water, then stir.</p></div>
      <div class="step"><div class="step__m"><img src="{{ 'gif-glass.gif' | asset_url }}" alt="Warm golden tea fresh from the microwave" width="300" height="400" loading="lazy"></div><h3>Heat &amp; sip</h3><p>Microwave 60 to 90 seconds. Cozy up.</p></div>
    </div>
    <div class="how__cta"><a href="#buy" class="btn btn--lg">Get the concentrate</a></div>
  </div>
</section>

<section class="sec sec--green">
  <div class="wrap split">
    <div class="split__m"><img src="{{ 'gif-cozy.gif' | asset_url }}" alt="Sipping tea under a blanket with a book" width="300" height="400" loading="lazy"></div>
    <div>
      
      <h2 class="sec__h">Your future self will thank you.</h2>
      <p class="sec__lead">One carton makes about eight cafe-size cups. Do the math once and you'll never wait in line for it again.</p>
      <div class="stats">
        <div><div class="stat__n">8</div><div class="stat__l">cups per carton</div></div>
        <div><div class="stat__n">2 min</div><div class="stat__l">carton to mug</div></div>
        <div><div class="stat__n">1:1</div><div class="stat__l">concentrate to water</div></div>
      </div>
    </div>
  </div>
</section>

<section class="sec" id="inside">
  <div class="wrap inside">
    <div class="inside__m">{%- if section.settings.hero_image != blank -%}<img src="{{ section.settings.hero_image | image_url: width: 900 }}" alt="LMTY Honey Citrus Mint Ball carton with orange, peach and mint" width="900" height="900" loading="lazy">{%- else -%}<img src="{{ 'lmty-ingredients.jpg' | asset_url }}" alt="Ingredients: lemon verbena, lemongrass, peach flavor, citrus flavor, spearmint and honey" width="1024" height="1024" loading="lazy">{%- endif -%}</div>
    <div>
      
      <h2 class="sec__h">Bright citrus. Cool mint. Smooth green tea.</h2>
      <p class="sec__lead">Already brewed and sweetened with honey and cane sugar. The full ingredient list is below.</p>
      <dl class="ing">
        <div><dt>Green tea</dt><dd>The smooth, lightly grassy base with a gentle lift of caffeine.</dd></div>
        <div><dt>Mint</dt><dd>Cool and fresh, the minty half of the flavor.</dd></div>
        <div><dt>Citrus</dt><dd>Bright lemony notes without the sour bite.</dd></div>
        <div><dt>Natural honey blend</dt><dd>Sweet enough as is. Add a squeeze of lemon if you like.</dd></div>
        <div><dt>A hint of peach</dt><dd>The soft fruity finish that makes it taste like the café cup.</dd></div>
      </dl>
    </div>
  </div>
</section>

<section class="sec sec--cream">
  <div class="wrap">
    <div class="sec__head sec__head--c"><h2 class="sec__h">Home vs. the drive-thru</h2></div>
    <table class="cmp">
      <thead><tr><th scope="col"></th><th scope="col" class="cmp__us">This concentrate</th><th scope="col">Café version</th><th scope="col">Tea bags + honey</th></tr></thead>
      <tbody>
        <tr><th scope="row">Cost per cup</th><td class="cmp__us">Under $3</td><td>$5+</td><td>About $1</td></tr>
        <tr><th scope="row">Ready in</th><td class="cmp__us">2 min</td><td>Drive + line</td><td>5+ min steep</td></tr>
        <tr><th scope="row">Honey citrus mint flavor</th><td class="cmp__us"><span class="y">Yes</span></td><td><span class="y">Yes</span></td><td><span class="n">Close-ish</span></td></tr>
        <tr><th scope="row">Make it in pajamas</th><td class="cmp__us"><span class="y">Yes</span></td><td><span class="n">No</span></td><td><span class="y">Yes</span></td></tr>
        <tr><th scope="row">Hot or iced</th><td class="cmp__us"><span class="y">Both</span></td><td><span class="y">Both</span></td><td><span class="n">Hot only</span></td></tr>
      </tbody>
    </table>
  </div>
</section>

<section class="sec" id="reviews">
  <div class="wrap">
    <div class="rev__top">
      <div><div class="rev__big">{{ reviews_n }}+</div><p style="color:var(--ink-2);font-size:.9rem">cartons sold through creator videos</p></div>
      <div style="margin-left:auto"><h2 class="sec__h">What people are saying</h2></div>
    </div>
    <div class="revs" data-revs>
      {%- assign revs = 'It tastes just as good|The same lemony minty goodness, but without the long line. It smells so good, and yes, it tastes just as good.|TikTok creator~An evening favorite|I love this in the evening if I just want something warm and tasty.|TikTok creator~Smells delicious|It smells delicious, it tastes even better. You can drink it hot or iced.|TikTok creator~Cozy in a cup|If cozy in a cup had a name, this would be it. Your future self will thank you.|TikTok creator~Hits the spot|Since it’s a concentrate you can make multiple for the whole week. It just hits the spot.|TikTok creator' | split: '~' -%}
      {%- for r in revs -%}{%- assign rp = r | split: '|' -%}
      <article class="rev"><span class="rev__real">Real review</span><div class="stars" aria-label="5 out of 5 stars">★★★★★</div><h3>{{ rp[0] }}</h3><p>{{ rp[1] }}</p><p class="rev__by"><strong>{{ rp[2] }}</strong> · from their TikTok video</p></article>
      {%- endfor -%}
    </div>
    <div class="rev__nav"><button type="button" aria-label="Previous reviews" data-rev-prev>&lsaquo;</button><button type="button" aria-label="Next reviews" data-rev-next>&rsaquo;</button></div>
    <div class="rev__more">
      
      <button type="button" class="btn" data-rev-write>Write a review</button>
    </div>
    <dialog class="modal" data-rev-modal>
      <form method="dialog" data-rev-form novalidate>
        <h2>Write a review</h2>
        <label>Name<input name="name" autocomplete="name" required></label>
        <label>Rating<select name="rating"><option value="5">5 stars</option><option value="4">4 stars</option><option value="3">3 stars</option><option value="2">2 stars</option><option value="1">1 star</option></select></label>
        <label>Review<textarea name="body" rows="4" required></textarea></label>
        <p class="modal__err" data-rev-err role="alert"></p>
        <div class="modal__row"><button type="button" class="btn btn--ghost" data-rev-cancel>Cancel</button><button type="submit" class="btn">Submit</button></div>
      </form>
    </dialog>
  </div>
</section>

{%- assign cm_n = 0 -%}{%- for b in section.blocks -%}{%- if b.type == 'comment' -%}{%- assign cm_n = cm_n | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- if cm_n > 0 -%}
<section class="sec sec--cream fbc" id="comments">
  <div class="wrap">
    <div class="sec__head sec__head--c">
      <p class="fbc__src"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#1877f2"/><path d="M13.4 19v-6h2l.3-2.4h-2.3V9.1c0-.7.2-1.2 1.2-1.2h1.2V5.8a17 17 0 0 0-1.8-.1c-1.8 0-3 1.1-3 3.1v1.8H9V13h2v6z" fill="#fff"/></svg>{{ section.settings.comments_eyebrow }}</p>
      <h2 class="fbc__h">{{ section.settings.comments_title }}</h2>
      <p class="sec__lead">{{ section.settings.comments_lead }}</p>
    </div>
    <div class="fbc__list">
      {%- assign open = false -%}
      {%- for b in section.blocks -%}{%- if b.type != 'comment' -%}{%- continue -%}{%- endif -%}
      {%- assign lvl = b.settings.level | plus: 0 -%}
      {%- if lvl == 0 -%}{%- if open -%}</div>{%- endif -%}<div class="fbc__card">{%- assign open = true -%}{%- endif -%}
      {%- assign initial = b.settings.name | slice: 0 | upcase -%}
      <div class="fbc__c fbc__c--{{ lvl }}" {{ b.shopify_attributes }}>
        <span class="fbc__av" style="--h:{{ b.settings.name | size | times: 47 | modulo: 360 }}" aria-hidden="true">{{ initial }}</span>
        <div class="fbc__main">
          <div class="fbc__bub"><p class="fbc__n">{{ b.settings.name }}{% if lvl != 1 %} · <span class="fbc__f">Follow</span>{% endif %}</p><p>{%- if b.settings.reply_to != blank -%}<strong>{{ b.settings.reply_to }}</strong> {% endif -%}{{ b.settings.text }}</p></div>
          <div class="fbc__meta"><span>{{ b.settings.age }}</span><button type="button" class="fbc__like" aria-pressed="false" data-like>Like</button><span>Reply</span>{%- if b.settings.likes > 0 -%}<span class="fbc__r"><i class="fbc__ic fbc__ic--l"></i>{% if b.settings.likes > 10 %}<i class="fbc__ic fbc__ic--h"></i>{% endif %}<span data-likes>{{ b.settings.likes }}</span></span>{%- endif -%}</div>
        </div>
      </div>
      {%- endfor -%}
      {%- if open -%}</div>{%- endif -%}
    </div>
