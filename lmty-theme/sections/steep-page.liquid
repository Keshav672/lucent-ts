{%- assign p = product -%}
{%- if p == blank -%}{%- assign p = section.settings.product -%}{%- endif -%}
{%- if p == blank -%}{%- assign p = settings.featured_product -%}{%- endif -%}
{%- if p == blank -%}{%- assign p = all_products['lmty-honey-citrus-mint-ball'] -%}{%- endif -%}
{%- assign v = p.selected_or_first_available_variant -%}
{%- if p.selected_variant == blank and p.variants.size > 1 and p.variants.last.available -%}{%- assign v = p.variants.last -%}{%- endif -%}
{%- assign best = v.price -%}{%- for var in p.variants -%}{%- assign nc = var.title | remove_first: 'Pack' | remove_first: 'pack' | strip | plus: 0 -%}{%- if nc < 1 -%}{%- assign nc = 1 -%}{%- endif -%}{%- assign pc = var.price | divided_by: nc -%}{%- if pc < best -%}{%- assign best = pc -%}{%- endif -%}{%- endfor -%}
{%- assign per_serv = best | divided_by: 5 -%}
{%- assign own = false -%}{%- if p.title contains 'LMTY' or p.title contains 'Citrus Mint' -%}{%- assign own = true -%}{%- endif -%}
{%- assign has_plans = false -%}{%- if p.selling_plan_groups.size > 0 -%}{%- assign has_plans = true -%}{%- endif -%}
{%- assign reviews_n = section.settings.review_count -%}

{%- if section.settings.show_hero -%}
<section class="hero">
  <div class="wrap hero__in">
    <div>
      <p class="eyebrow" style="color:var(--honey)">Honey · Citrus · Mint</p>
      <h1 class="hero__h">Café-style comfort. <em>Made at home.</em></h1>
      <p class="hero__lead">Bright citrus, cool mint, smooth green tea and honey sweetness in an easy-to-prepare concentrate. Enjoy it warm or iced, without the long line.</p>
      <ul class="chips"><li>32 oz concentrate</li><li>Green tea</li><li>Hot or iced</li><li>~5 servings</li></ul>
      <div class="hero__row">
        <a href="#buy" class="btn btn--lg btn--light">Add to cart · {{ v.price | money }}</a>
        <a href="#buy" class="btn btn--lg btn--outline">Choose your pack</a>
      </div>
      <p class="hero__note">Free shipping on every order · Ships from the US</p>
    </div>
    <div class="hero__media hero__media--img">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1100 }}" alt="{{ section.settings.hero_image.alt | default: 'LMTY Honey Citrus Mint Ball green tea concentrate' | escape }}" width="1100" height="1100" fetchpriority="high">
            {%- else -%}
        <img src="{{ 'lmty-carton.jpg' | asset_url }}" alt="LMTY Honey Citrus Mint Ball green tea concentrate" width="1024" height="1024" fetchpriority="high">
      {%- endif -%}
    </div>
  </div>
</section>
<div class="proof">
  <div class="wrap proof__in">
    <div class="proof__i"><div class="proof__n">1,000+</div><div class="proof__l">cartons sold this season</div></div>
    <div class="proof__i"><div class="proof__n">32 oz</div><div class="proof__l">concentrate per carton</div></div>
    <div class="proof__i"><div class="proof__n">2 min</div><div class="proof__l">from carton to mug</div></div>
    <div class="proof__i"><div class="proof__n">$0</div><div class="proof__l">shipping, every order</div></div>
  </div>
</div>
{%- endif -%}

<section class="buy" id="buy">
  <div class="wrap buy__in">
    <div class="gal" data-gallery>
      <div class="gal__main">
        {%- if own and p.media.size > 0 -%}
          {%- for m in p.media -%}{%- if m.media_type == 'image' -%}
          <img src="{{ m | image_url: width: 1100 }}" alt="{{ m.alt | default: p.title | escape }}" width="1100" height="1100" data-slide{% unless forloop.first %} hidden loading="lazy"{% endunless %}>
          {%- endif -%}{%- endfor -%}
        {%- else -%}
          <img src="{{ 'lmty-carton.jpg' | asset_url }}" alt="LMTY Honey Citrus Mint Ball 32 oz green tea concentrate carton" width="1024" height="1024" data-slide>
          <img src="{{ 'lmty-ingredients.jpg' | asset_url }}" alt="Ingredients: lemon verbena, lemongrass, peach flavor, citrus flavor, spearmint and honey" width="1024" height="1024" data-slide hidden loading="lazy">
          <img src="{{ 'lmty-iced.jpg' | asset_url }}" alt="LMTY poured over ice with orange, mint and honey" width="1024" height="1024" data-slide hidden loading="lazy">
          <img src="{{ 'lmty-nutrition.jpg' | asset_url }}" alt="Nutrition Facts: about 5 servings, 85 calories, 19g added sugars per serving. Ingredients: green tea infusion (water, green tea, lemon verbena, spearmint, lemongrass), honey, cane sugar, citric acid, natural flavor." width="1024" height="1024" data-slide hidden loading="lazy">
          <img src="{{ 'gif-glass.gif' | asset_url }}" alt="A warm glass of honey citrus mint tea" width="300" height="400" data-slide hidden loading="lazy">
        {%- endif -%}
        <button type="button" class="gal__nav gal__nav--p" aria-label="Previous image" data-prev>&lsaquo;</button>
        <button type="button" class="gal__nav gal__nav--n" aria-label="Next image" data-next>&rsaquo;</button>
      </div>
      <div class="gal__thumbs" data-thumbs>
        {%- if own and p.media.size > 0 -%}
          {%- for m in p.media -%}{%- if m.media_type == 'image' -%}
          <button type="button" aria-label="Show image {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}><img src="{{ m | image_url: width: 160 }}" alt="" width="72" height="72" loading="lazy"></button>
          {%- endif -%}{%- endfor -%}
        {%- else -%}
          <button type="button" aria-label="Show image 1" aria-current="true"><img src="{{ 'lmty-carton.jpg' | asset_url }}" alt="" width="72" height="72" loading="lazy"></button>
          <button type="button" aria-label="Show image 2"><img src="{{ 'lmty-ingredients.jpg' | asset_url }}" alt="" width="72" height="72" loading="lazy"></button>
          <button type="button" aria-label="Show image 3"><img src="{{ 'lmty-iced.jpg' | asset_url }}" alt="" width="72" height="72" loading="lazy"></button>
          <button type="button" aria-label="Show image 4"><img src="{{ 'lmty-nutrition.jpg' | asset_url }}" alt="" width="72" height="72" loading="lazy"></button>
          <button type="button" aria-label="Show image 5"><img src="{{ 'gif-glass.gif' | asset_url }}" alt="" width="72" height="72" loading="lazy"></button>
          {%- endif -%}
      </div>
    </div>

    <div>
      {%- assign rc = section.settings.rating_count | plus: 0 -%}
      {%- if rc > 0 and section.settings.rating_value != blank -%}
      {%- assign rv = section.settings.rating_value | plus: 0 -%}
      <a href="#reviews" class="rating" aria-label="Rated {{ rv }} out of 5 from {{ rc }} reviews">
        <span class="rating__stars" style="--r:{{ rv | times: 20 }}%" aria-hidden="true"><span>★★★★★</span></span>
        <strong>{{ rv }}/5</strong><span>· {{ rc }} reviews{% if section.settings.rating_source != blank %} on {{ section.settings.rating_source }}{% endif %}</span>
      </a>
      {%- endif -%}
      {%- if section.settings.trustbox != blank -%}<div class="trustbox">{{ section.settings.trustbox }}</div>{%- endif -%}
      <p class="buy__rating">{{ reviews_n }}+ cartons sold</p>
      {%- if section.settings.show_hero -%}<h2 class="buy__t">{% if own %}{{ p.title }}{% else %}LMTY Honey Citrus Mint Ball{% endif %}</h2>{%- else -%}<h1 class="buy__t">{% if own %}{{ p.title }}{% else %}LMTY Honey Citrus Mint Ball{% endif %}</h1>{%- endif -%}
      <p class="buy__sub">Green tea, honey, citrus, mint and a hint of peach. Mix with an equal amount of water for a cozy café-style cup, warm or iced.</p>
      <ul class="ticks">
        <li>Tastes just as good as the café version</li>
        <li>About 5 café-size servings per carton</li>
        <li>Drink it hot or iced</li>
      </ul>
      <div class="pricerow">
        <span class="pricerow__now" data-price-label>{{ v.price | money }}</span>
        {%- if v.compare_at_price > v.price -%}<s class="pricerow__was">{{ v.compare_at_price | money }}</s><span class="pill">Save {{ v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price | floor }}%</span>{%- endif -%}
      </div>

      {%- form 'product', p, data-buy-form: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ v.id }}" data-variant-id>
        {%- unless p.has_only_default_variant -%}
        <fieldset class="opts">
          <legend class="opt-l">Size</legend>
          {%- for var in p.variants -%}
          <label class="opt{% if forloop.last and p.variants.size > 1 %} opt--pop{% endif %}">
            {%- if forloop.last and p.variants.size > 1 -%}<span class="opt__flag">Most popular</span>{%- endif -%}
            <input type="radio" name="steep-variant" value="{{ var.id }}" data-price="{{ var.price }}" data-compare="{{ var.compare_at_price | default: 0 }}"{% if var.id == v.id %} checked{% endif %}{% unless var.available %} disabled{% endunless %}>
            <span class="opt__b"><span class="opt__t">{{ var.title }}</span>{% unless var.available %}<span class="opt__s"> · Sold out</span>{% endunless %}</span>
            {%- assign n_cart = var.title | remove_first: 'Pack' | remove_first: 'pack' | strip | plus: 0 -%}
            <span class="opt__p">{{ var.price | money }}{% if n_cart > 1 %}<small class="opt__per">{{ var.price | divided_by: n_cart | money }} per carton</small>{% endif %}{% if var.compare_at_price > var.price %}<s>{{ var.compare_at_price | money }}</s>{% endif %}</span>
          </label>
          {%- endfor -%}
        </fieldset>
        {%- endunless -%}
        <div class="shipnote"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg><div><strong>Free shipping</strong><span>Tracked delivery from a US warehouse</span></div></div>

        {%- if has_plans -%}
        {%- assign plan = p.selling_plan_groups.first.selling_plans.first -%}
        <fieldset class="opts" data-plans>
          <legend class="opt-l">Purchase type</legend>
          <label class="opt">
            <input type="radio" name="selling_plan" value="{{ plan.id }}" checked>
            <span class="opt__b"><span class="opt__t">Subscribe &amp; save <span class="tag">Best value</span></span><span class="opt__s">{{ plan.name }} · skip or cancel anytime</span></span>
          </label>
          <label class="opt">
            <input type="radio" name="selling_plan" value="">
            <span class="opt__b"><span class="opt__t">One-time purchase</span></span>
          </label>
        </fieldset>
        {%- endif -%}

        <div class="buy__qty">
          <div class="qty"><button type="button" aria-label="Decrease quantity" data-qty-minus>&minus;</button><input type="number" name="quantity" value="1" min="1" max="20" aria-label="Quantity" data-qty><button type="button" aria-label="Increase quantity" data-qty-plus>+</button></div>
          <button type="submit" class="btn btn--lg" data-add{% unless v.available %} disabled{% endunless %}>
            {%- if v.available -%}Add to cart · <span data-price-label>{{ v.price | money }}</span>{%- else -%}Sold out{%- endif -%}
          </button>
        </div>
        <p class="buy__msg" role="status" aria-live="polite" data-buy-msg></p>
        <a href="#guarantee" class="guarbadge">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
          <span><strong>Arrives damaged? We replace it free.</strong>Plus 30-day returns on unopened cartons.</span>
        </a>
      {%- endform -%}

      <ul class="trust">
        <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"/></svg>Secure checkout</li>
        <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12l4 4 10-10"/></svg>30-day returns</li>
        <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/></svg>Free US shipping</li>
      </ul>

      <details class="acc" open><summary>How to make it</summary><div class="acc__b"><p>Hot: ¾ cup concentrate plus ¾ cup water in a mug, microwave 60 to 90 seconds, stir.</p><p>Iced: pour over ice, top with cold water or lemonade.</p></div></details>
      <details class="acc"><summary>Ingredients</summary><div class="acc__b"><p>Green tea, lemon verbena, spearmint, lemongrass, honey, cane sugar, citric acid and natural flavors. Contains caffeine from green tea. Check the carton for the current full ingredient list.</p></div></details>
      <details class="acc"><summary>Size &amp; nutrition</summary><div class="acc__b"><p>32 fl oz (946 mL) carton, about 5 servings. One serving is ¾ cup concentrate mixed with ¾ cup water. Full Nutrition Facts are below.</p></div></details>
      <details class="acc"><summary>Shipping &amp; returns</summary><div class="acc__b"><p>Free shipping on every order. Unopened cartons can be returned within 30 days of delivery.</p></div></details>
    </div>
  </div>
</section>

<section class="blend" id="blend">
  <div class="wrap">
    <h2 class="blend__h"><span>Know this</span> <em>amazing blend</em></h2>
    <p class="blend__lead">The four flavors you taste in every pour.</p>
    <ul class="blend__list">
      {%- assign ing_n = 0 -%}{%- for b in section.blocks -%}{%- if b.type == 'ingredient' -%}{%- assign ing_n = ing_n | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if ing_n > 0 -%}
        {%- for b in section.blocks -%}{%- if b.type != 'ingredient' -%}{%- continue -%}{%- endif -%}
        <li class="blend__i" style="--d:{{ forloop.index0 | times: 120 }}ms" {{ b.shopify_attributes }}>
          <div class="blend__art">{%- if b.settings.image != blank -%}<img src="{{ b.settings.image | image_url: width: 320 }}" alt="{{ b.settings.title | escape }}" width="160" height="160" loading="lazy">{%- else -%}{% render 'blend-art', name: b.settings.art %}{%- endif -%}</div>
          <h3>{{ b.settings.title }}</h3><p>{{ b.settings.text }}</p>
        </li>
        {%- endfor -%}
      {%- else -%}
        {%- assign blend = 'green-tea|Green Tea|Smooth and lightly grassy, with a gentle lift.|tea~lemon-verbena|Lemon Verbena|Bright, lemony and fresh, without the sour bite.|verbena~spearmint|Spearmint|Cool and fresh, the minty half of the magic.|mint~honey|Honey|Honey sweetness that wraps it all together.|honey' | split: '~' -%}
        {%- for x in blend -%}{%- assign bp = x | split: '|' -%}
        <li class="blend__i" style="--d:{{ forloop.index0 | times: 120 }}ms">
          <div class="blend__art blend__art--photo"><img src="{{ 'blend-' | append: bp[3] | append: '.jpg' | asset_url }}" alt="{{ bp[1] }}" width="160" height="160" loading="lazy"></div>
          <h3>{{ bp[1] }}</h3><p>{{ bp[2] }}</p>
        </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

<section class="sec">
  <div class="wrap note">
    <div class="note__m"><img src="{{ 'lmty-iced.jpg' | asset_url }}" alt="LMTY poured over ice with orange and mint" width="1024" height="1024" loading="lazy"></div>
    <div>
      <p class="eyebrow">Who you're buying from</p>
      <h2 class="sec__h">We just wanted the café cup without the drive.</h2>
      <p class="sec__lead">LMTY started with one habit: a honey citrus mint tea from the café, a few times a week, and a line every time. A concentrate made it a two-minute thing at home, so that's what we sell.</p>
      <p class="sec__lead">We're a small team. We answer our own emails, and if your carton arrives damaged we'll replace it.</p>
      <p class="note__by">The LMTY team</p>
    </div>
  </div>
</section>

{%- unless section.settings.classic -%}
<section class="sec sec--green">
  <div class="wrap">
    <div class="sec__head">
      
      <h2 class="sec__h">Your new favorite tea ritual.</h2>
    </div>
    <div class="bens">
      <div class="ben"><h3>Café-style flavor</h3><p>The honey citrus mint combo you order out, without the drive or the $6 cup.</p></div>
      <div class="ben"><h3>Smells delicious</h3><p>Honey, citrus and mint hit you the second you pour. It tastes even better.</p></div>
      <div class="ben"><h3>Tucked in your pantry</h3><p>Keep a carton on hand so a cozy cup is always a few minutes away.</p></div>
      <div class="ben"><h3>Hot or iced</h3><p>Microwave it for a cozy mug or pour it over ice in summer. Same carton.</p></div>
    </div>
  </div>
</section>
{%- endunless -%}

{%- unless section.settings.classic -%}
<section class="sec sec--green">
  <div class="wrap">
    <h2 class="sec__h">Everything in the carton, printed on the front.</h2>
    <div class="specs">
      <div class="spec"><div class="spec__n">32 oz</div><h3>Concentrate</h3><p>946 mL, already brewed and sweetened.</p></div>
      <div class="spec"><div class="spec__n">~5</div><h3>Servings</h3><p>¾ cup concentrate + ¾ cup water each.</p></div>
      <div class="spec"><div class="spec__n">2 min</div><h3>Carton to mug</h3><p>Pour, add water, heat or ice.</p></div>
      <div class="spec"><div class="spec__n">Low</div><h3>Caffeine</h3><p>A light lift from green tea, less than coffee.</p></div>
    </div>
  </div>
</section>
{%- endunless -%}

<section class="sec" id="how">
  <div class="wrap">
    <div class="sec__head sec__head--c">
      <p class="eyebrow">How to make it</p>
      <h2 class="sec__h">Three steps. Two minutes.</h2>
      <p class="sec__lead">No steeping, no tea bags. Just pour and mix.</p>
    </div>
    <div class="steps">
      <div class="step"><div class="step__m"><img src="{{ 'gif-overhead.gif' | asset_url }}" alt="Concentrate pouring into a mug" width="300" height="375" loading="lazy"></div><h3>Pour</h3><p>Pour ¾ cup of concentrate into your mug.</p></div>
      <div class="step"><div class="step__m"><img src="{{ 'gif-pour.gif' | asset_url }}" alt="Hot water poured in and stirred" width="300" height="400" loading="lazy"></div><h3>Top up</h3><p>Add ¾ cup water, then stir.</p></div>
      <div class="step"><div class="step__m"><img src="{{ 'gif-glass.gif' | asset_url }}" alt="Warm golden tea fresh from the microwave" width="300" height="400" loading="lazy"></div><h3>Heat &amp; sip</h3><p>Microwave 60 to 90 seconds. Cozy up.</p></div>
    </div>
  </div>
</section>

<section class="sec sec--cream" id="why">
  <div class="wrap">
    <div class="sec__head sec__head--c"><h2 class="sec__h">It's not your tea. It's the steeping.</h2><p class="sec__lead">Same flavors, two very different evenings.</p></div>
    <div class="chk">
      <div class="chk__col chk__col--no">
        <h3>Tea bags + honey</h3>
        <ul><li>Boil water, steep 5 minutes, fish out the bag</li><li>Measure honey, squeeze lemon, find the mint</li><li>Tastes different every time</li><li>Hot only, unless you wait for it to cool</li></ul>
      </div>
      <div class="chk__col chk__col--yes">
        <h3>LMTY concentrate</h3>
        <ul><li>Pour, add water, heat. About 2 minutes</li><li>Honey, citrus and mint already in the carton</li><li>Same café-style cup, every time</li><li>Hot or iced from the same carton</li></ul>
      </div>
    </div>
  </div>
</section>

<section class="sec" id="guarantee" style="padding-top:0">
  <div class="wrap">
    <div class="guar">
      <div><h2 class="sec__h">Try a carton. If it arrives damaged, it's on us.</h2><p>Unopened cartons can be returned within 30 days. Damaged in transit? Email us a photo and we'll send a replacement.</p></div>
      <div class="guar__cta"><a href="#buy" class="btn btn--lg">Add to cart · {{ v.price | money }}</a><small>Free shipping on every order</small></div>
    </div>
  </div>
</section>

<section class="sec anchor">
  <div class="wrap anchor__in">
    <div><h2 class="sec__h">Café-style, for less than the café.</h2><p class="sec__lead">One carton makes about 5 servings. With the 2 Pack, that's about {{ per_serv | money }} a serving at home, versus $5 or more at the counter.</p></div>
    <div class="anchor__cmp" aria-label="Price per cup comparison">
      <div><span class="anchor__k">Café cup</span><span class="anchor__bar anchor__bar--cafe"></span><strong>$5+</strong></div>
      <div><span class="anchor__k">LMTY at home</span><span class="anchor__bar anchor__bar--us" style="--w:{{ per_serv | times: 100 | divided_by: 500 }}%"></span><strong>{{ per_serv | money }}</strong></div>
    </div>
  </div>
</section>

{%- unless section.settings.classic -%}
<section class="sec" id="inside">
  <div class="wrap inside">
    <div class="inside__m">{%- if section.settings.hero_image != blank -%}<img src="{{ section.settings.hero_image | image_url: width: 900 }}" alt="LMTY Honey Citrus Mint Ball carton with orange, peach and mint" width="900" height="900" loading="lazy">{%- else -%}<img src="{{ 'lmty-ingredients.jpg' | asset_url }}" alt="Ingredients: lemon verbena, lemongrass, peach flavor, citrus flavor, spearmint and honey" width="1024" height="1024" loading="lazy">{%- endif -%}</div>
    <div>
      
      <h2 class="sec__h">Bright citrus. Cool mint. Smooth green tea.</h2>
      <p class="sec__lead">Already brewed and sweetened with honey and cane sugar. The full ingredient list is below.</p>
      <dl class="ing">
        <div><dt>Green tea</dt><dd>The smooth, lightly grassy base with a gentle lift of caffeine.</dd></div>
        <div><dt>Mint</dt><dd>Cool and fresh, the minty half of the flavor.</dd></div>
        <div><dt>Citrus</dt><dd>Bright lemony notes without the sour bite.</dd></div>
        <div><dt>Natural honey blend</dt><dd>Sweet enough as is. Add a squeeze of lemon if you like.</dd></div>
        <div><dt>A hint of peach</dt><dd>The soft fruity finish that makes it taste like the café cup.</dd></div>
      </dl>
      <details class="nf-wrap">
        <summary>Nutrition Facts &amp; full ingredients</summary>
        <div class="nf" role="table" aria-label="Nutrition Facts">
          <p class="nf__t">Nutrition Facts</p>
          <p>about 5 servings per container</p>
          <p class="nf__row nf__row--b"><strong>Serving size</strong><strong>¾ cup concentrate (180mL)<br>prepared with ¾ cup water</strong></p>
          <p class="nf__sm"><strong>Amount per serving</strong></p>
          <p class="nf__cal"><span>Calories</span><span>85</span></p>
          <p class="nf__dv">% Daily Value*</p>
          <p class="nf__row"><span><strong>Total Fat</strong> 0g</span><strong>0%</strong></p>
          <p class="nf__row nf__in"><span>Saturated Fat 0g</span><strong>0%</strong></p>
          <p class="nf__row nf__in"><span><em>Trans</em> Fat 0g</span><span></span></p>
          <p class="nf__row"><span><strong>Cholesterol</strong> 0mg</span><strong>0%</strong></p>
          <p class="nf__row"><span><strong>Sodium</strong> 0mg</span><strong>0%</strong></p>
          <p class="nf__row"><span><strong>Total Carbohydrate</strong> 19g</span><strong>7%</strong></p>
          <p class="nf__row nf__in"><span>Dietary Fiber 0g</span><strong>0%</strong></p>
          <p class="nf__row nf__in"><span>Total Sugars 19g</span><span></span></p>
          <p class="nf__row nf__in2"><span>Includes 19g Added Sugars</span><strong>38%</strong></p>
          <p class="nf__row nf__row--k"><span><strong>Protein</strong> 0g</span><span></span></p>
          <p class="nf__row"><span>Vitamin D 0mcg</span><span>0%</span></p>
          <p class="nf__row"><span>Calcium 0mg</span><span>0%</span></p>
          <p class="nf__row"><span>Iron 0mg</span><span>0%</span></p>
          <p class="nf__row nf__row--k"><span>Potassium 0mg</span><span>0%</span></p>
          <p class="nf__fn">* The % Daily Value (DV) tells you how much a nutrient in a serving of food contributes to a daily diet. 2,000 calories a day is used for general nutrition advice.</p>
        </div>
        <p class="nf__ing"><strong>Ingredients:</strong> green tea infusion (water, green tea, lemon verbena, spearmint, lemongrass), honey, cane sugar, citric acid, natural flavor.</p>
      </details>
    </div>
  </div>
</section>
{%- endunless -%}

{%- unless section.settings.classic -%}
<section class="sec sec--cream">
  <div class="wrap">
    <div class="sec__head sec__head--c"><h2 class="sec__h">Home vs. the drive-thru</h2></div>
    <table class="cmp">
      <thead><tr><th scope="col"></th><th scope="col" class="cmp__us">This concentrate</th><th scope="col">Café version</th><th scope="col">Tea bags + honey</th></tr></thead>
      <tbody>
        <tr><th scope="row">Cost per serving</th><td class="cmp__us">From {{ per_serv | money }}</td><td>$5+</td><td>About $1</td></tr>
        <tr><th scope="row">Ready in</th><td class="cmp__us">2 min</td><td>Drive + line</td><td>5+ min steep</td></tr>
        <tr><th scope="row">Honey citrus mint flavor</th><td class="cmp__us"><span class="y">Yes</span></td><td><span class="y">Yes</span></td><td><span class="n">Close-ish</span></td></tr>
        <tr><th scope="row">Make it in pajamas</th><td class="cmp__us"><span class="y">Yes</span></td><td><span class="n">No</span></td><td><span class="y">Yes</span></td></tr>
        <tr><th scope="row">Hot or iced</th><td class="cmp__us"><span class="y">Both</span></td><td><span class="y">Both</span></td><td><span class="n">Hot only</span></td></tr>
      </tbody>
    </table>
  </div>
</section>
{%- endunless -%}

<section class="sec" id="reviews">
  <div class="wrap">
    <div class="rev__top">
      <div><div class="rev__big">{{ reviews_n }}+</div><p style="color:var(--ink-2);font-size:.9rem">cartons sold</p></div>
      <div style="margin-left:auto"><h2 class="sec__h">What people are saying</h2></div>
    </div>
    <div class="revs" data-revs>
      {%- assign revs = 'It tastes just as good|The same lemony minty goodness, but without the long line. It smells so good, and yes, it tastes just as good.|TikTok creator~An evening favorite|I love this in the evening if I just want something warm and tasty.|TikTok creator~Smells delicious|It smells delicious, it tastes even better. You can drink it hot or iced.|TikTok creator~Cozy in a cup|If cozy in a cup had a name, this would be it. Your future self will thank you.|TikTok creator~Hits the spot|Since it’s a concentrate you can make multiple cups. It just hits the spot.|TikTok creator' | split: '~' -%}
      {%- for r in revs -%}{%- assign rp = r | split: '|' -%}
      <article class="rev"><span class="rev__real">Real review</span><div class="stars" aria-label="5 out of 5 stars">★★★★★</div><h3>{{ rp[0] }}</h3><p>{{ rp[1] }}</p></article>
      {%- endfor -%}
    </div>
    <div class="rev__nav"><button type="button" aria-label="Previous reviews" data-rev-prev>&lsaquo;</button><button type="button" aria-label="Next reviews" data-rev-next>&rsaquo;</button></div>

  </div>
</section>

{%- assign cm_n = 0 -%}{%- for b in section.blocks -%}{%- if b.type == 'comment' -%}{%- assign cm_n = cm_n | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- if cm_n > 0 -%}
<section class="sec sec--cream fbc" id="comments">
  <div class="wrap">
    <div class="sec__head sec__head--c">
      <p class="fbc__src"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#1877f2"/><path d="M13.4 19v-6h2l.3-2.4h-2.3V9.1c0-.7.2-1.2 1.2-1.2h1.2V5.8a17 17 0 0 0-1.8-.1c-1.8 0-3 1.1-3 3.1v1.8H9V13h2v6z" fill="#fff"/></svg>{{ section.settings.comments_eyebrow }}</p>
      <h2 class="fbc__h">{{ section.settings.comments_title }}</h2>
      <p class="sec__lead">{{ section.settings.comments_lead }}</p>
    </div>
    <div class="fbc__list">
      {%- assign open = false -%}
      {%- for b in section.blocks -%}{%- if b.type != 'comment' -%}{%- continue -%}{%- endif -%}
      {%- assign lvl = b.settings.level | plus: 0 -%}
      {%- if lvl == 0 -%}{%- if open -%}</div>{%- endif -%}<div class="fbc__card">{%- assign open = true -%}{%- endif -%}
      {%- assign initial = b.settings.name | slice: 0 | upcase -%}
      <div class="fbc__c fbc__c--{{ lvl }}" {{ b.shopify_attributes }}>
        <span class="fbc__av" style="--h:{{ b.settings.name | size | times: 47 | modulo: 360 }}" aria-hidden="true">{{ initial }}</span>
        <div class="fbc__main">
          <div class="fbc__bub"><p class="fbc__n">{{ b.settings.name }}{% if lvl != 1 %} · <span class="fbc__f">Follow</span>{% endif %}</p><p>{%- if b.settings.reply_to != blank -%}<strong>{{ b.settings.reply_to }}</strong> {% endif -%}{{ b.settings.text }}</p></div>
          <div class="fbc__meta"><span>{{ b.settings.age }}</span><button type="button" class="fbc__like" aria-pressed="false" data-like>Like</button><span>Reply</span>{%- if b.settings.likes > 0 -%}<span class="fbc__r"><i class="fbc__ic fbc__ic--l"></i>{% if b.settings.likes > 10 %}<i class="fbc__ic fbc__ic--h"></i>{% endif %}<span data-likes>{{ b.settings.likes }}</span></span>{%- endif -%}</div>
        </div>
      </div>
      {%- endfor -%}
      {%- if open -%}</div>{%- endif -%}
    </div>
    <p class="fbc__note">Real comments from our ads, lightly edited for length. Individual results vary.</p>
  </div>
</section>
{%- endif -%}

<section class="sec sec--cream" id="faq">
  <div class="wrap">
    <div class="sec__head sec__head--c"><h2 class="sec__h">Good questions</h2></div>
    <div class="faq">
      <details class="acc"><summary>Is this the same tea the cafés use?</summary><div class="acc__b"><p>It's a honey citrus mint green tea concentrate made for café-style drinks at home. Mix ¾ cup with ¾ cup hot water; for the full café version, add a splash of hot lemonade.</p></div></details>
      <details class="acc"><summary>How many servings are in a carton?</summary><div class="acc__b"><p>About 5 servings: each is ¾ cup concentrate plus ¾ cup water (1½ cups total).</p></div></details>
      <details class="acc"><summary>Does it have caffeine?</summary><div class="acc__b"><p>Yes, a little, from the green tea. Less than a cup of coffee.</p></div></details>
      <details class="acc"><summary>How do I store it?</summary><div class="acc__b"><p>Unopened cartons keep in the pantry. Once open, keep it in the fridge and follow the storage note on the carton.</p></div></details>
      <details class="acc"><summary>Can I drink it iced?</summary><div class="acc__b"><p>Absolutely. Pour over ice and top with cold water or lemonade.</p></div></details>
      <details class="acc"><summary>How long does shipping take?</summary><div class="acc__b"><p>Orders ship from a US warehouse within 1 to 2 business days and usually arrive in 3 to 5. Shipping is free.</p></div></details>
    </div>
  </div>
</section>

<div class="sticky" data-sticky aria-hidden="true">
  <div class="wrap sticky__in">
    {%- if own and p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 120 }}" alt="" width="48" height="48">{%- endif -%}
    <div><div class="sticky__t">{% if own %}{{ p.title }}{% else %}LMTY Honey Citrus Mint Ball{% endif %}</div><div class="sticky__p"><span data-price-label>{{ v.price | money }}</span> · Free shipping</div></div>
    <button type="button" class="btn" data-sticky-add tabindex="-1"{% unless v.available %} disabled{% endunless %}>Add to cart</button>
  </div>
</div>


{% schema %}
{
  "name": "Steep landing",
  "settings": [
    {"type": "checkbox", "id": "show_hero", "label": "Show hero + proof strip", "default": true},
    {"type": "checkbox", "id": "classic", "label": "Classic (shorter) layout", "default": false},
    {"type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Square product shot. Falls back to the product's first image."},
    {"type": "product", "id": "product", "label": "Product (home page only)"},
    {"type": "text", "id": "comments_eyebrow", "label": "Comments: eyebrow", "default": "From our Facebook ad comments"},
    {"type": "text", "id": "comments_title", "label": "Comments: heading", "default": "Don't take our word for it. Ask the comments."},
    {"type": "text", "id": "comments_lead", "label": "Comments: intro", "default": "Every time someone asks a question under our ads, the answers come from people who already tried it."},
    {"type": "header", "content": "Rating badge (real numbers only)"},
    {"type": "text", "id": "rating_value", "label": "Average rating (e.g. 4.8)", "info": "Copy from your review app or TikTok Shop. Leave blank to hide."},
    {"type": "number", "id": "rating_count", "label": "Number of reviews"},
    {"type": "text", "id": "rating_source", "label": "Where the reviews are from (e.g. TikTok Shop, Judge.me)"},
    {"type": "html", "id": "trustbox", "label": "Trustpilot TrustBox code", "info": "Paste the TrustBox snippet from your Trustpilot business account."},
    {"type": "number", "id": "review_count", "label": "Order count shown next to rating", "default": 1000}
  ],
  "blocks": [
    {"type": "ingredient", "name": "Blend ingredient", "settings": [
      {"type": "text", "id": "title", "label": "Name", "default": "Green Tea"},
      {"type": "text", "id": "text", "label": "One-line description"},
      {"type": "image_picker", "id": "image", "label": "Cut-out photo (transparent PNG)"},
      {"type": "select", "id": "art", "label": "Illustration if no photo", "default": "green-tea", "options": [
        {"value": "green-tea", "label": "Green tea"}, {"value": "lemon-verbena", "label": "Lemon verbena"},
        {"value": "spearmint", "label": "Spearmint"}, {"value": "honey", "label": "Honey"}]}
    ]}
  ,
    {"type": "comment", "name": "Ad comment", "settings": [
      {"type": "paragraph", "content": "Paste a real comment from your ads, word for word. Level 0 starts a new thread; 1 and 2 are replies under it."},
      {"type": "text", "id": "name", "label": "Commenter name (first name + initial)", "default": "Name"},
      {"type": "select", "id": "level", "label": "Level", "default": "0", "options": [{"value": "0", "label": "Top comment"}, {"value": "1", "label": "Reply"}, {"value": "2", "label": "Reply to reply"}]},
      {"type": "text", "id": "reply_to", "label": "Replying to (name, optional)"},
      {"type": "textarea", "id": "text", "label": "Comment text"},
      {"type": "text", "id": "age", "label": "Age label", "default": "1w"},
      {"type": "number", "id": "likes", "label": "Reactions", "default": 0}
    ]}
  ],
  "presets": [{"name": "Steep landing"}]
}
{% endschema %}
