{%- assign p = product -%}
{%- if p == blank -%}{%- assign p = section.settings.product -%}{%- endif -%}
{%- if p == blank -%}{%- assign p = settings.featured_product -%}{%- endif -%}
{%- if p == blank -%}{%- assign p = all_products['lmty-honey-citrus-mint-ball'] -%}{%- endif -%}
{%- assign v = p.selected_or_first_available_variant -%}
{%- if p.selected_variant == blank and p.variants.size > 1 -%}
  {%- assign v = p.variants.last -%}
  {%- for var in p.variants -%}{%- assign tn = var.title | remove_first: 'Pack' | remove_first: 'pack' | strip | plus: 0 -%}{%- if tn == 3 and var.available -%}{%- assign v = var -%}{%- endif -%}{%- endfor -%}
{%- endif -%}
{%- assign best = v.price -%}{%- for var in p.variants -%}{%- assign nc = var.title | remove_first: 'Pack' | remove_first: 'pack' | strip | plus: 0 -%}{%- if nc < 1 -%}{%- assign nc = 1 -%}{%- endif -%}{%- assign pc = var.price | divided_by: nc -%}{%- if pc < best -%}{%- assign best = pc -%}{%- endif -%}{%- endfor -%}
{%- assign per_serv = best | divided_by: 5 -%}
{%- assign own = false -%}{%- if p.title contains 'LMTY' or p.title contains 'Citrus Mint' -%}{%- assign own = true -%}{%- endif -%}
{%- assign has_plans = false -%}{%- if p.selling_plan_groups.size > 0 -%}{%- assign has_plans = true -%}{%- endif -%}
{%- assign reviews_n = section.settings.review_count -%}

{%- if section.settings.show_hero -%}
<section class="hero">
  <div class="wrap hero__in">
    <div>
      <p class="eyebrow" style="color:var(--honey)">Honey · Citrus · Mint</p>
      <h1 class="hero__h">Café-style comfort. <em>Made at home.</em></h1>
      <p class="hero__lead">Bright citrus, cool mint, smooth green tea and honey sweetness in an easy-to-prepare concentrate. Enjoy it warm or iced, without the long line.</p>
      <ul class="chips"><li>32 oz concentrate</li><li>Green tea</li><li>Hot or iced</li><li>~5 servings</li></ul>
      <div class="hero__row">
        <a href="#buy" class="btn btn--lg btn--light">Add to cart</a>
        <a href="#buy" class="btn btn--lg btn--outline">Choose your pack</a>
      </div>
      <p class="hero__note">Free shipping on orders $40+ · Ships from the US</p>
    </div>
    <div class="hero__media hero__media--img">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1100 }}" alt="{{ section.settings.hero_image.alt | default: 'LMTY Honey Citrus Mint Ball green tea concentrate' | escape }}" width="1100" height="1100" fetchpriority="high">
            {%- else -%}
        <img src="{{ 'lmty-carton.jpg' | asset_url }}" alt="LMTY Honey Citrus Mint Ball green tea concentrate" width="1024" height="1024" fetchpriority="high">
      {%- endif -%}
    </div>
  </div>
</section>
<div class="proof">
  <div class="wrap proof__in">
    <div class="proof__i"><div class="proof__n">1,000+</div><div class="proof__l">cartons sold this season</div></div>
    <div class="proof__i"><div class="proof__n">32 oz</div><div class="proof__l">concentrate per carton</div></div>
    <div class="proof__i"><div class="proof__n">2 min</div><div class="proof__l">from carton to mug</div></div>
    <div class="proof__i"><div class="proof__n">$40+</div><div class="proof__l">ships free</div></div>
  </div>
</div>
{%- endif -%}

<section class="buy" id="buy">
  <div class="wrap buy__in">
    <div class="gal" data-gallery>
      <div class="gal__main">
        {%- if own and p.media.size > 0 -%}
          {%- for m in p.media -%}{%- if m.media_type == 'image' -%}
          <img src="{{ m | image_url: width: 1100 }}" alt="{{ m.alt | default: p.title | escape }}" width="1100" height="1100" data-slide{% unless forloop.first %} hidden loading="lazy"{% endunless %}>
          {%- endif -%}{%- endfor -%}
        {%- else -%}
          <img src="{{ 'lmty-carton.jpg' | asset_url }}" alt="LMTY Honey Citrus Mint Ball 32 oz green tea concentrate carton" width="1024" height="1024" data-slide>
          <img src="{{ 'lmty-ingredients.jpg' | asset_url }}" alt="Ingredients: lemon verbena, lemongrass, peach flavor, citrus flavor, spearmint and honey" width="1024" height="1024" data-slide hidden loading="lazy">
        {%- endif -%}
          <img src="{{ 'lmty-iced.jpg' | asset_url }}" alt="LMTY poured over ice with orange, mint and honey" width="1024" height="1024" data-slide hidden loading="lazy">
          <img src="{{ 'lmty-nutrition.jpg' | asset_url }}" alt="Nutrition Facts: about 5 servings, 85 calories, 19g added sugars per serving. Ingredients: green tea infusion (water, green tea, lemon verbena, spearmint, lemongrass), honey, cane sugar, citric acid, natural flavor." width="1024" height="1024" data-slide hidden loading="lazy">
        <button type="button" class="gal__nav gal__nav--p" aria-label="Previous image" data-prev>&lsaquo;</button>
        <button type="button" class="gal__nav gal__nav--n" aria-label="Next image" data-next>&rsaquo;</button>
      </div>
      <div class="gal__thumbs" data-thumbs>
        {%- if own and p.media.size > 0 -%}
          {%- for m in p.media -%}{%- if m.media_type == 'image' -%}
          <button type="button" aria-label="Show image {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}><img src="{{ m | image_url: width: 160 }}" alt="" width="72" height="72" loading="lazy"></button>
          {%- endif -%}{%- endfor -%}
        {%- else -%}
          <button type="button" aria-label="Show image 1" aria-current="true"><img src="{{ 'lmty-carton.jpg' | asset_url }}" alt="" width="72" height="72" loading="lazy"></button>
          <button type="button" aria-label="Show image 2"><img src="{{ 'lmty-ingredients.jpg' | asset_url }}" alt="" width="72" height="72" loading="lazy"></button>
          {%- endif -%}
          <button type="button" aria-label="Show iced drink photo"><img src="{{ 'lmty-iced.jpg' | asset_url }}" alt="" width="72" height="72" loading="lazy"></button>
          <button type="button" aria-label="Show nutrition facts"><img src="{{ 'lmty-nutrition.jpg' | asset_url }}" alt="" width="72" height="72" loading="lazy"></button>
      </div>
    </div>

    <div>
      {%- assign rc = section.settings.rating_count | plus: 0 -%}
      {%- if rc > 0 and section.settings.rating_value != blank -%}
      {%- assign rv = section.settings.rating_value | plus: 0 -%}
      <a href="#reviews" class="rating" aria-label="Rated {{ rv }} out of 5 from {{ rc }} reviews">
        <span class="rating__stars" style="--r:{{ rv | times: 20 }}%" aria-hidden="true"><span>★★★★★</span></span>
        <strong>{{ rv }}/5</strong><span>· {{ rc }} reviews{% if section.settings.rating_source != blank %} on {{ section.settings.rating_source }}{% endif %}</span>
      </a>
      {%- endif -%}
      {%- if section.settings.trustbox != blank -%}<div class="trustbox">{{ section.settings.trustbox }}</div>{%- endif -%}
      <p class="buy__rating">{{ reviews_n }}+ cartons sold</p>
      {%- if section.settings.show_hero -%}<h2 class="buy__t">{% if own %}{{ p.title }}{% else %}LMTY Honey Citrus Mint Ball{% endif %}</h2>{%- else -%}<h1 class="buy__t">{% if own %}{{ p.title }}{% else %}LMTY Honey Citrus Mint Ball{% endif %}</h1>{%- endif -%}
      <p class="buy__sub">Green tea, honey, citrus, mint and a hint of peach. Mix with an equal amount of water for a cozy café-style cup, warm or iced.</p>
      <ul class="feats">
        <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 4h8v3l2 3v9a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1v-9l2-3z"/><path d="M6 13h12"/></svg>Sweetened With Real Honey</li>
        <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18c6 0 12-5 12-13-8 0-12 5-12 13zM6 18l6-6"/></svg>Spearmint &amp; Lemon Verbena</li>
        <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 3L5 14h6l-1 7 8-11h-6z"/></svg>85 Calories Per Serving</li>
        <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 9h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5z"/><path d="M16 10h1.5a2.5 2.5 0 0 1 0 5H16"/></svg>Low Caffeine Green Tea</li>
      </ul>
      {%- assign vn = v.title | remove_first: 'Pack' | remove_first: 'pack' | strip | plus: 0 -%}{%- if vn < 1 -%}{%- assign vn = 1 -%}{%- endif -%}
      {%- assign vcmp = v.compare_at_price | default: v.price -%}
      <div class="pricerow">
        <span class="pricerow__now"><span data-hero-unit>{{ v.price | divided_by: vn | money }}</span><small>/carton</small></span>
        <s class="pricerow__was" data-hero-was{% unless vcmp > v.price %} hidden{% endunless %}>{{ vcmp | divided_by: vn | money }}</s>
        <span class="pill" data-save-override="{{ section.settings.save_override }}" data-hero-pill{% unless vcmp > v.price %} hidden{% endunless %}>{{ section.settings.sale_label | default: 'Sale' | upcase }} - SAVE {% if section.settings.save_override != blank %}{{ section.settings.save_override }}{% else %}{{ vcmp | minus: v.price | times: 100 | divided_by: vcmp | floor }}{% endif %}%</span>
      </div>

      {%- form 'product', p, data-buy-form: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ v.id }}" data-variant-id>
        {%- comment -%} Three fixed Pinemoor tiers. Each tier is the product variant whose title holds its carton count (1 / 3 / 6). Buy One falls back to the cheapest variant so it is always buyable. {%- endcomment -%}
        {%- assign base = p.variants.first -%}{%- assign base_found = false -%}
        {%- for var in p.variants -%}
          {%- assign digits = var.title | replace: '-', ' ' | replace: 'x', ' ' | split: ' ' -%}
          {%- for d in digits -%}{%- assign dn = d | plus: 0 -%}{%- if dn == 1 and base_found == false -%}{%- assign base = var -%}{%- assign base_found = true -%}{%- endif -%}{%- endfor -%}
        {%- endfor -%}
        {%- unless base_found -%}{%- for var in p.variants -%}{%- if var.price < base.price -%}{%- assign base = var -%}{%- endif -%}{%- endfor -%}{%- endunless -%}
        {%- assign base_cmp = base.compare_at_price | default: base.price -%}
        {%- assign checked_n = 1 -%}
        <fieldset class="tiers" data-tiers>
          <legend class="sr">Choose your bundle</legend>
          {%- for n in (1..3) -%}
            {%- case n -%}
              {%- when 1 -%}{%- assign cnt = 1 -%}{%- assign tname = 'Buy One' -%}{%- assign pimg = 'pack-1.jpg' -%}
              {%- when 2 -%}{%- assign cnt = 3 -%}{%- assign tname = 'Buy 2 Get 1 FREE' -%}{%- assign pimg = 'pack-3.jpg' -%}
              {%- else -%}{%- assign cnt = 6 -%}{%- assign tname = 'Buy 3 Get 3 FREE' -%}{%- assign pimg = 'pack-6.jpg' -%}
            {%- endcase -%}
            {%- assign found = false -%}
            {%- if n == 1 -%}
              {%- assign found = true -%}{%- assign tvar = base -%}
            {%- else -%}
              {%- for var in p.variants -%}
                {%- assign digits = var.title | replace: '-', ' ' | replace: 'x', ' ' | split: ' ' -%}
                {%- for d in digits -%}{%- assign dn = d | plus: 0 -%}{%- if dn == cnt and found == false -%}{%- assign found = true -%}{%- assign tvar = var -%}{%- endif -%}{%- endfor -%}
              {%- endfor -%}
            {%- endif -%}
            {%- if found -%}
              {%- assign t_id = tvar.id -%}{%- assign t_price = tvar.price -%}{%- assign t_cmp = tvar.compare_at_price | default: tvar.price -%}{%- assign t_ok = tvar.available -%}
              {%- assign t_plan = tvar.price -%}{%- if has_plans and tvar.selling_plan_allocations.size > 0 -%}{%- assign t_plan = tvar.selling_plan_allocations.first.price -%}{%- endif -%}
            {%- else -%}
              {%- assign t_id = base.id -%}{%- assign t_price = base.price | times: cnt -%}{%- assign t_cmp = base_cmp | times: cnt -%}{%- assign t_ok = false -%}{%- assign t_plan = t_price -%}
            {%- endif -%}
            {%- if t_ok -%}{%- assign checked_n = n -%}{%- endif -%}
            {%- assign t_qty = 1 -%}
            {%- assign unit = t_price | divided_by: cnt -%}{%- assign cmp_unit = t_cmp | divided_by: cnt -%}
            {%- assign saved = t_cmp | minus: t_price -%}
          <label class="tier">
            {%- if n == 3 -%}<span class="tier__flag">Best value</span>{%- endif -%}
            <span class="tier__row">
              <input type="radio" name="steep-tier" value="{{ t_id }}" data-qty="{{ t_qty }}" data-code="{{ t_code | escape }}" data-price="{{ t_price }}" data-plan-price="{{ t_plan }}" data-compare="{{ t_cmp }}" data-n="{{ cnt }}"{% unless t_ok %} disabled{% endunless %}>
              <img class="tier__img" src="{{ pimg | asset_url }}" alt="" width="60" height="60" loading="lazy">
              <span class="tier__b"><span class="tier__t">{{ tname }}</span><span class="tier__s">{{ cnt }} Carton{% if cnt > 1 %}s{% endif %}{% if t_ok and saved > 0 %} · You save <span data-saved>{{ saved | money_without_trailing_zeros }}</span>{% endif %}{% unless t_ok %}{% if found %} · Sold out{% else %} · Not set up yet{% endif %}{% endunless %}</span></span>
              <span class="tier__p"><strong><span data-unit>{{ unit | money }}</span><small>/carton</small></strong>{% if cmp_unit > unit %}<s>{{ cmp_unit | money }}</s>{% endif %}</span>
            </span>
            {%- if n > 1 -%}
            <span class="tier__perks">
              {%- if section.settings.perk_1 != blank -%}<span><b>+</b><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg>{{ section.settings.perk_1 }}</span>{%- endif -%}
              {%- if n == 3 -%}
              {%- if section.settings.perk_2 != blank -%}<span><b>+</b><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="9" width="16" height="11" rx="1"/><path d="M3 9h18M12 9v11M12 9c-2-4-6-4-6-1s6 1 6 1 6 2 6-1-4-3-6 1"/></svg>{{ section.settings.perk_2 }}</span>{%- endif -%}
              {%- if section.settings.perk_3 != blank -%}<span><b>+</b><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>{{ section.settings.perk_3 }}</span>{%- endif -%}
              {%- endif -%}
            </span>
            {%- endif -%}
          </label>
          {%- endfor -%}
        </fieldset>

        {%- if has_plans -%}
        {%- assign plan = p.selling_plan_groups.first.selling_plans.first -%}
        <input type="hidden" name="selling_plan" value="" data-plan-input data-plan-id="{{ plan.id }}">
        <label class="subtog">
          <input type="checkbox" data-plan-toggle>
          <span><strong>Subscribe &amp; Save</strong><small>Delivered {{ plan.name | downcase | remove: 'subscribe & save' | strip | default: 'monthly' }} · Cancel anytime · Skip or pause whenever</small></span>
        </label>
        {%- endif -%}

        <p class="eta"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Order now for delivery by: <strong data-eta data-days="{{ section.settings.delivery_days | default: 5 }}">within {{ section.settings.delivery_days | default: 5 }} business days</strong></p>
        {%- if has_plans -%}<p class="subnote" data-plan-note hidden>Ships every month at the price shown. Cancel, skip or pause anytime, no fees.</p>{%- endif -%}

        <input type="hidden" name="quantity" value="1" data-qty-input>
        <button type="submit" class="btn btn--block atc" data-add{% unless v.available %} disabled{% endunless %}>
          {%- if v.available -%}
          <span class="atc__main">Add to cart</span>
          <span class="atc__sub"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"/></svg>Free replacement if it arrives damaged</span>
          {%- else -%}Sold out{%- endif -%}
        </button>
        <p class="buy__msg" role="status" aria-live="polite" data-buy-msg></p>
      {%- endform -%}

      <ul class="trust">
        <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"/></svg>Damage Guarantee</li>
        <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18c6 0 12-5 12-13-8 0-12 5-12 13zM6 18l6-6"/></svg>Real Green Tea</li>
        <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4v3h6V4M9 12h6M9 16h4"/></svg>Real Honey</li>
        <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/></svg>Ships From US</li>
      </ul>

      <details class="acc" open><summary>How to make it</summary><div class="acc__b"><p>Hot: ¾ cup concentrate plus ¾ cup water in a mug, microwave 60 to 90 seconds, stir.</p><p>Iced: pour over ice, top with cold water or lemonade.</p></div></details>
      <details class="acc"><summary>Ingredients</summary><div class="acc__b"><p>Green tea, lemon verbena, spearmint, lemongrass, honey, cane sugar, citric acid and natural flavors. Contains caffeine from green tea. Check the carton for the current full ingredient list.</p></div></details>
      <details class="acc"><summary>Size &amp; nutrition</summary><div class="acc__b"><p>32 fl oz (946 mL) carton, about 5 servings. One serving is ¾ cup concentrate mixed with ¾ cup water. Full Nutrition Facts are below.</p></div></details>
      <details class="acc"><summary>Shipping &amp; returns</summary><div class="acc__b"><p>Free shipping on orders $40+. Unopened cartons can be returned within 30 days of delivery.</p></div></details>
    </div>
  </div>
</section>

<section class="blend" id="blend">
  <div class="wrap">
    <h2 class="blend__h"><span>Know this</span> <em>amazing blend</em></h2>
    <p class="blend__lead">The four flavors you taste in every pour.</p>
    <ul class="blend__list">
      {%- assign ing_n = 0 -%}{%- for b in section.blocks -%}{%- if b.type == 'ingredient' -%}{%- assign ing_n = ing_n | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if ing_n > 0 -%}
        {%- for b in section.blocks -%}{%- if b.type != 'ingredient' -%}{%- continue -%}{%- endif -%}
        <li class="blend__i" style="--d:{{ forloop.index0 | times: 120 }}ms" {{ b.shopify_attributes }}>
          <div class="blend__art">{%- if b.settings.image != blank -%}<img src="{{ b.settings.image | image_url: width: 320 }}" alt="{{ b.settings.title | escape }}" width="160" height="160" loading="lazy">{%- else -%}{% render 'blend-art', name: b.settings.art %}{%- endif -%}</div>
          <h3>{{ b.settings.title }}</h3><p>{{ b.settings.text }}</p>
        </li>
        {%- endfor -%}
      {%- else -%}
        {%- assign blend = 'green-tea|Green Tea|Smooth and lightly grassy, with a gentle lift.|tea~lemon-verbena|Lemon Verbena|Bright, lemony and fresh, without the sour bite.|verbena~spearmint|Spearmint|Cool and fresh, the minty half of the magic.|mint~honey|Honey|Honey sweetness that wraps it all together.|honey' | split: '~' -%}
        {%- for x in blend -%}{%- assign bp = x | split: '|' -%}
        <li class="blend__i" style="--d:{{ forloop.index0 | times: 120 }}ms">
          <div class="blend__art blend__art--photo"><img src="{{ 'blend-' | append: bp[3] | append: '.jpg' | asset_url }}" alt="{{ bp[1] }}" width="160" height="160" loading="lazy"></div>
          <h3>{{ bp[1] }}</h3><p>{{ bp[2] }}</p>
        </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

<section class="sec">
  <div class="wrap note">
    <div class="note__m"><img src="{{ 'lmty-iced.jpg' | asset_url }}" alt="LMTY poured over ice with orange and mint" width="1024" height="1024" loading="lazy"></div>
    <div>
      <p class="eyebrow">Who you're buying from</p>
      <h2 class="sec__h">We just wanted the café cup without the drive.</h2>
      <p class="sec__lead">LMTY started with one habit: a honey citrus mint tea from the café, a few times a week, and a line every time. A concentrate made it a two-minute thing at home, so that's what we sell.</p>
      <p class="sec__lead">We're a small team. We answer our own emails, and if your carton arrives damaged we'll replace it.</p>
      <p class="note__by">The LMTY team</p>
    </div>
  </div>
</section>

{%- unless section.settings.classic -%}
<section class="sec sec--cream bens-sec">
  <div class="wrap">
    <div class="sec__head">
      
      <h2 class="sec__h">Your new favorite tea ritual.</h2>
    </div>
    <div class="bens">
      <div class="ben"><svg class="ben__ic" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 9h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5z"/><path d="M16 10h1.5a2.5 2.5 0 0 1 0 5H16"/><path d="M8 3v3M11 3v3"/></svg><h3>Café-style flavor</h3><p>The honey citrus mint combo you order out, without the drive or the $6 cup.</p></div>
      <div class="ben"><svg class="ben__ic" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 20c-2-2-2-4 0-6s2-4 0-6"/><path d="M13 20c-2-2-2-4 0-6s2-4 0-6"/><path d="M18 20c-2-2-2-4 0-6s2-4 0-6"/></svg><h3>Smells delicious</h3><p>Honey, citrus and mint hit you the second you pour. It tastes even better.</p></div>
