<section class="simple-page"><div class="wrap"><header class="simple-page__head"><p class="eyebrow">Shop</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="rte simple-page__intro">{{ collection.description }}</div>{% endif %}</header><div class="product-grid">{% for product in collection.products %}<a href="{{ product.url }}" class="product-tile">{% if product.featured_image %}<div class="product-tile__media"><img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="600" height="600" loading="lazy"></div>{% endif %}<div class="product-tile__body"><h2>{{ product.title }}</h2><p>{{ product.price | money }}</p><span class="link-arrow">View product →</span></div></a>{% else %}<p>No products yet.</p>{% endfor %}</div></div></section>
