<section class="page"><div class="wrap page__narrow"><h1>Search</h1>
<form action="{{ routes.search_url }}" method="get" class="sform" role="search"><label class="vh" for="q">Search</label><input id="q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products and pages"><button type="submit" class="btn">Search</button></form>
{%- if search.performed -%}<p class="muted">{{ search.results_count }} results for “{{ search.terms | escape }}”</p><div class="slist">{%- for item in search.results -%}<a href="{{ item.url }}">{{ item.title }}</a>{%- else -%}<p style="padding-top:12px">Nothing matched. Try “lithium”.</p>{%- endfor -%}</div>{%- endif -%}
</div></section>
