<section class="page"><div class="wrap page__narrow"><h1>{{ blog.title }}</h1><div class="slist" style="margin-top:20px">{%- for article in blog.articles -%}<a href="{{ article.url }}">{{ article.title }}<br><span class="muted" style="font-weight:400;font-size:13px">{{ article.published_at | date: '%B %d, %Y' }}</span></a>{%- else -%}<p>No posts yet.</p>{%- endfor -%}</div></div></section>
