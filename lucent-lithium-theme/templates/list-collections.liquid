<section class="page"><div class="wrap"><h1>Collections</h1><div class="grid grid--3" style="margin-top:24px">{%- for c in collections -%}<a href="{{ c.url }}" class="ptile"><div class="ptile__m">{%- if c.featured_image -%}<img src="{{ c.featured_image | image_url: width: 600 }}" alt="" width="600" height="600" loading="lazy">{%- endif -%}</div><strong>{{ c.title }}</strong></a>{%- endfor -%}</div></div></section>
