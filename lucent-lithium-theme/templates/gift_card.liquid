{%- layout none -%}
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Gift card – {{ shop.name }}</title>{{ content_for_header }}{{ 'lucent.css' | asset_url | stylesheet_tag }}</head>
<body><section class="page"><div class="wrap page__narrow page__center"><span class="logo"><span class="logo__dot"></span>Lucent</span><h1 style="margin:20px 0 8px">Here's your gift card</h1><p class="lead" style="margin-inline:auto">{{ gift_card.initial_value | money }} for {{ shop.name }}</p><p style="margin:24px 0;font-size:24px;letter-spacing:.1em;font-weight:700">{{ gift_card.code | format_code }}</p>{%- if gift_card.expired -%}<p class="muted">This card has expired.</p>{%- endif -%}<p><a href="{{ shop.url }}" class="btn">Start shopping</a></p></div></section></body></html>
