<section class="page"><div class="wrap page__narrow"><h1>Choose a new password</h1>{%- form 'reset_customer_password', class: 'form', style: 'margin-top:24px' -%}{{ form.errors | default_errors }}<label class="field">Password<input type="password" name="customer[password]" autocomplete="new-password" required></label><label class="field">Confirm password<input type="password" name="customer[password_confirmation]" required></label><button type="submit" class="btn">Save password</button>{%- endform -%}</div></section>
