<section class="page"><div class="wrap page__narrow"><p class="eyebrow">Order {{ order.name }}</p><h1 style="margin:8px 0 6px">{{ order.created_at | date: '%B %d, %Y' }}</h1><p class="muted" style="margin-bottom:24px">{{ order.fulfillment_status_label }} · {{ order.financial_status_label }}</p>
<table class="tbl"><thead><tr><th>Item</th><th>Qty</th><th>Total</th></tr></thead><tbody>{%- for line in order.line_items -%}<tr><td>{{ line.title }}</td><td>{{ line.quantity }}</td><td>{{ line.final_line_price | money }}</td></tr>{%- endfor -%}</tbody></table>
<div class="summary" style="margin-top:24px;position:static"><div class="cart__row" style="font-weight:400"><span>Subtotal</span><span>{{ order.subtotal_price | money }}</span></div><div class="cart__row" style="font-weight:400"><span>Shipping</span><span>{{ order.shipping_price | money }}</span></div><div class="cart__row"><span>Total</span><span>{{ order.total_price | money }}</span></div></div>
{%- if order.shipping_address -%}<h2 style="font-size:20px;margin-top:32px">Shipping to</h2><div class="addr" style="margin-top:12px">{{ order.shipping_address | format_address }}</div>{%- endif -%}
<p><a href="{{ routes.account_url }}" class="link">Back to account</a></p></div></section>
