<section class="page"><div class="wrap page__narrow"><h1>Activate your account</h1>{%- form 'activate_customer_password', class: 'form', style: 'margin-top:24px' -%}{{ form.errors | default_errors }}<label class="field">Password<input type="password" name="customer[password]" autocomplete="new-password" required></label><label class="field">Confirm password<input type="password" name="customer[password_confirmation]" required></label><div style="display:flex;gap:10px"><button type="submit" class="btn">Activate</button><button type="submit" name="decline" class="btn btn--ghost">Decline</button></div>{%- endform -%}</div></section>
