<section class="page"><div class="wrap page__narrow page__center"><span class="logo"><span class="logo__dot"></span>Lucent</span><h1 style="margin:24px 0 12px">Opening soon.</h1><p class="lead" style="margin-inline:auto">Low-dose lithium orotate for a steadier mood. Leave your email and we'll tell you first.</p>
{%- form 'customer', class: 'news', style: 'margin:24px auto 0' -%}<input type="hidden" name="contact[tags]" value="prospect"><label class="vh" for="pw-email">Email</label><input id="pw-email" type="email" name="contact[email]" placeholder="Email" required><button type="submit" class="btn btn--sm">Notify me</button>{%- endform -%}
<details style="margin-top:32px"><summary class="link" style="cursor:pointer">Enter using password</summary>{%- form 'storefront_password', class: 'form', style: 'margin:16px auto 0' -%}{{ form.errors | default_errors }}<label class="field">Password<input type="password" name="password" required></label><button type="submit" class="btn">Enter</button>{%- endform -%}</details>
</div></section>
