{%- comment -%}Fractional star rating: grey row underneath, gold row clipped to rating / 5 (4.7 → 94%).{%- endcomment -%}
{%- assign r = rating | default: 5 | times: 1.0 -%}{%- if r > 5 -%}{%- assign r = 5.0 -%}{%- endif -%}
{%- assign pct = r | times: 20 -%}
{%- capture star -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.8l2.8 6 6.5.7-4.9 4.4 1.4 6.4L12 17l-5.8 3.3 1.4-6.4L2.7 9.5l6.5-.7z"/></svg>{%- endcapture -%}
<span class="stars" role="img" aria-label="Rated {{ r }} out of 5"><span class="stars__row">{{ star }}{{ star }}{{ star }}{{ star }}{{ star }}</span><span class="stars__fill" style="width:{{ pct }}%"><span class="stars__row">{{ star }}{{ star }}{{ star }}{{ star }}{{ star }}</span></span></span>
