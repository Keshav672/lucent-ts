{%- comment -%}Featured product resolver (inline: render tags can't set parent variables){%- endcomment -%}
{%- assign fp = settings.featured_product -%}
{%- if fp == blank -%}{%- assign fp = all_products['lucent-lithium-orotate'] -%}{%- endif -%}
{%- if fp == blank -%}{%- for p in collections['all'].products -%}{%- if p.title contains 'ithium' -%}{%- assign fp = p -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}
{%- if fp == blank and collections['all'].products.size > 0 -%}{%- assign fp = collections['all'].products.first -%}{%- endif -%}
{%- if fp != blank -%}{%- assign fp_url = fp.url -%}{%- else -%}{%- assign fp_url = routes.root_url -%}{%- endif -%}
{%- assign contact_page = pages['contact'] -%}{%- if contact_page != blank -%}{%- assign contact_url = contact_page.url -%}{%- else -%}{%- assign contact_url = 'mailto:' | append: shop.email -%}{%- endif -%}
{%- assign ship_page = pages['shipping-returns'] -%}{%- if ship_page != blank -%}{%- assign ship_url = ship_page.url -%}{%- else -%}{%- assign ship_url = contact_url -%}{%- endif -%}
{%- assign faq_page = pages['faq'] -%}{%- if faq_page != blank -%}{%- assign faq_url = faq_page.url -%}{%- else -%}{%- assign faq_url = routes.root_url | append: '#faq' -%}{%- endif -%}
{%- assign science_page = pages['science'] -%}{%- if science_page != blank -%}{%- assign science_url = science_page.url -%}{%- else -%}{%- assign science_url = routes.root_url | append: '#science' -%}{%- endif -%}
{%- assign support_email = settings.support_email | default: shop.email -%}
<footer class="foot">
  <div class="wrap">
    <div class="foot__grid">
      <div class="foot__brand">
        <span class="logo"><span class="logo__dot"></span>Lucent</span>
        <p>Low-dose lithium orotate for a steadier mood and a sharper mind. Made in the USA.</p>
        {%- form 'customer', class: 'news', id: 'news-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="vh" for="news-email">Email address</label>
          <input id="news-email" type="email" name="contact[email]" placeholder="Email for tips and offers" required autocomplete="email">
          <button type="submit" class="btn btn--sm">Sign up</button>
        {%- endform -%}
        <p class="muted" style="font-size:13px;margin-top:8px" data-news-msg hidden>Thanks, you're on the list.</p>
      </div>
      <div class="foot__col"><h4>Shop</h4><a href="{{ fp_url }}">Lithium Orotate</a><a href="{{ routes.root_url }}">All products</a><a href="{{ routes.cart_url }}">Cart</a></div>
      <div class="foot__col"><h4>Learn</h4><a href="{{ science_url }}">Science</a><a href="{{ fp_url }}#ingredients">Supplement facts</a><a href="{{ faq_url }}">FAQ</a></div>
      <div class="foot__col"><h4>Support</h4><a href="{{ contact_url }}">Contact</a><a href="{{ ship_url }}">Shipping &amp; returns</a><a href="{{ routes.account_url }}">Account</a><a href="mailto:{{ support_email }}">{{ support_email }}</a></div>
    </div>
    <div class="foot__legal">
      <p>&copy; {{ 'now' | date: '%Y' }} Lucent. All rights reserved.</p>
      <p><a href="{{ ship_url }}">Shipping</a><a href="{{ contact_url }}">Privacy</a><a href="{{ contact_url }}">Terms</a></p>
    </div>
    <p class="foot__disc">*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Lithium orotate is a low-dose trace mineral supplement, not prescription lithium. Consult your healthcare provider before use if you are pregnant, nursing, taking medication, or have a medical condition.</p>
  </div>
</footer>
