{%- comment -%}Scrolling announcement ticker. Messages come from Theme settings → Announcement bar; the list is repeated so the loop is seamless at any screen width.{%- endcomment -%}
{%- assign bar_msgs = '' -%}
{%- if settings.bar_1 != blank -%}{%- assign bar_msgs = bar_msgs | append: settings.bar_1 | append: '|' -%}{%- endif -%}
{%- if settings.bar_2 != blank -%}{%- assign bar_msgs = bar_msgs | append: settings.bar_2 | append: '|' -%}{%- endif -%}
{%- if settings.bar_3 != blank -%}{%- assign bar_msgs = bar_msgs | append: settings.bar_3 | append: '|' -%}{%- endif -%}
{%- assign bar_list = bar_msgs | split: '|' -%}
{%- if bar_msgs != blank -%}
<div class="bar" role="region" aria-label="Store announcements">
  <p class="vh">{%- for m in bar_list -%}{%- if m != blank -%}{{ m }}. {% endif -%}{%- endfor -%}</p>
  <div class="bar__track" aria-hidden="true">
    {%- for half in (1..2) -%}
    <ul class="bar__list">
      {%- for rep in (1..3) -%}{%- for m in bar_list -%}{%- if m != blank -%}<li>{{ m }}</li>{%- endif -%}{%- endfor -%}{%- endfor -%}
    </ul>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}
