{%- assign cur = product.selected_or_first_available_variant -%}
<section class="pdp" data-pdp>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Shop</a> / <span>{{ product.title }}</span></nav>
    <div class="pdp__grid">
      <div class="gal">
        <div class="gal__main">
          {%- assign slides = 0 -%}
          {%- for m in product.media -%}
            {%- assign slides = slides | plus: 1 -%}
            <div class="gal__slide{% if forloop.first %} is-on{% endif %}" data-slide>
              {%- if m.media_type == 'video' -%}{{ m | video_tag: playsinline: true, muted: true, loop: true, controls: false }}
              {%- else -%}<img src="{{ m | image_url: width: 1200 }}" alt="{{ m.alt | default: product.title | escape }}" width="1200" height="1200"{% unless forloop.first %} loading="lazy"{% endunless %}>{%- endif -%}
            </div>
          {%- endfor -%}
          {%- if slides == 0 -%}
            {%- assign fallback = 'bottle-hero.jpg,bottle-white.jpg,panel-benefits.jpg,panel-directions.jpg,panel-results.jpg,facts.jpg,panel-guarantee.jpg' | split: ',' -%}
            {%- for f in fallback -%}<div class="gal__slide{% if forloop.first %} is-on{% endif %}" data-slide><img src="{{ f | asset_url }}" alt="{{ product.title | escape }}" width="1200" height="1200"></div>{%- endfor -%}
          {%- endif -%}
          <button type="button" class="gal__arrow gal__arrow--prev" aria-label="Previous image" data-prev>{% render 'icon', name: 'chev-l' %}</button>
          <button type="button" class="gal__arrow gal__arrow--next" aria-label="Next image" data-next>{% render 'icon', name: 'chev-r' %}</button>
        </div>
        <div class="gal__thumbs">
          {%- if slides > 0 -%}
            {%- for m in product.media -%}<button type="button" aria-label="Image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-thumb><img src="{{ m.preview_image | image_url: width: 160 }}" alt="" width="72" height="72" loading="lazy"></button>{%- endfor -%}
          {%- else -%}
            {%- for f in fallback -%}<button type="button" aria-label="Image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-thumb><img src="{{ f | asset_url }}" alt="" width="72" height="72"></button>{%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <div class="buy" data-buy>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h1>{{ product.title }}</h1>
        <p class="rating">{% render 'stars', rating: settings.rating %} <span>{{ settings.rating | default: '4.7' }} · {{ settings.review_count | default: '2,140' }} reviews</span></p>
        <p class="buy__lead" style="margin-top:12px">{{ section.settings.lead }}</p>
        <ul class="buy__bul">
          {%- for b in section.blocks -%}{%- if b.type == 'bullet' -%}<li {{ b.shopify_attributes }}><span class="check">{% render 'icon', name: 'check' %}</span><span>{{ b.settings.text }}</span></li>{%- endif -%}{%- endfor -%}
        </ul>

        {%- comment -%}Default selection: the variant in the URL, else the middle bundle, else the first.{%- endcomment -%}
        {%- assign sel_id = cur.id -%}
        {%- unless product.selected_variant -%}{%- for v in product.variants reversed -%}{%- if v.available -%}{%- assign sel_id = v.id -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endunless -%}
        {%- form 'product', product, id: 'pdp-form', data-product-form: true, data-ajax: true -%}
          <input type="hidden" name="id" value="{{ sel_id }}">
          <input type="hidden" name="selling_plan" value="">
          <input type="hidden" name="quantity" value="1">
          {%- for v in product.variants -%}{%- if v.id == sel_id -%}
            {%- assign n = v.title | split: ' ' | first | plus: 0 -%}{%- if n < 1 -%}{%- assign n = 1 -%}{%- endif -%}
            {%- assign cmp = v.compare_at_price | default: 0 -%}
            <div class="buy__price">
              <strong data-price-out>{{ v.price | divided_by: n | money }}</strong><span class="buy__per">/bottle</span>
              <s data-compare-out{% unless cmp > v.price %} hidden{% endunless %}>{{ cmp | divided_by: n | money }}</s>
              <span class="buy__badge" data-save{% unless cmp > v.price %} hidden{% endunless %}>{{ section.settings.sale_label | default: 'Fall sale' }} · Save {{ cmp | minus: v.price | times: 100 | divided_by: cmp }}%</span>
            </div>
          {%- endif -%}{%- endfor -%}
          <p class="buy__grp">Choose your supply</p>
          {%- for v in product.variants -%}
            {%- assign label = v.title -%}{%- if product.has_only_default_variant -%}{%- assign label = '1 bottle' -%}{%- endif -%}
            {%- assign n = v.title | split: ' ' | first | plus: 0 -%}{%- if n < 1 -%}{%- assign n = 1 -%}{%- endif -%}
            {%- assign cmp = v.compare_at_price | default: 0 -%}
            {%- assign per = v.price | divided_by: n -%}
            {%- assign cper = cmp | divided_by: n -%}
            {%- assign save = cmp | minus: v.price -%}
            {%- assign pct = 0 -%}{%- if cmp > v.price -%}{%- assign pct = save | times: 100 | divided_by: cmp -%}{%- endif -%}
            <label class="opt opt--bundle">
              <input type="radio" name="purchase" value="v{{ v.id }}" data-variant="{{ v.id }}" data-price="{{ v.price }}" data-per="{{ per }}" data-cper="{{ cper }}" data-pct="{{ pct }}" data-label="{{ label | escape }}"{% if v.id == sel_id %} checked{% endif %}{% unless v.available %} disabled{% endunless %}>
              <span class="opt__main">
                <span class="opt__t">{{ label }}{% unless v.available %} · Sold out{% endunless %}</span>
                <span class="opt__s">{{ n }}-month supply{% if save > 0 %} · You save {{ save | money }}{% endif %}</span>
                {%- if pct > 0 -%}<span class="opt__sale">{{ section.settings.sale_label | default: 'Fall sale' }} · {{ pct }}% off</span>{%- endif -%}
              </span>
              <span class="opt__p"><span class="opt__pp"><strong>{{ per | money }}</strong><small>/bottle</small></span>{% if cper > per %}<s>{{ cper | money }}</s>{% endif %}</span>
              {%- if product.variants.size > 1 and forloop.index == 2 -%}
              <span class="opt__more opt__perks"><span class="opt__perk"><span class="opt__perk-ck">{% render 'icon', name: 'check' %}</span><span class="opt__perk-ic">{% render 'icon', name: 'truck' %}</span><span><strong>{{ section.settings.perk2_title }}</strong><small>{{ section.settings.perk2_sub }}</small></span></span><span class="opt__perk"><span class="opt__perk-ck">{% render 'icon', name: 'check' %}</span><span class="opt__perk-ic">{% render 'icon', name: 'lock' %}</span><span><strong>{{ section.settings.perk2b_title }}</strong><small>{{ section.settings.perk2b_sub }}</small></span></span></span>
              {%- elsif forloop.last and forloop.index > 2 -%}
              <span class="opt__more opt__perks"><span class="opt__perk"><span class="opt__perk-ck">{% render 'icon', name: 'check' %}</span><span class="opt__perk-ic">{% render 'icon', name: 'truck' %}</span><span><strong>{{ section.settings.perk_title }}</strong><small>{{ section.settings.perk_sub }}</small></span></span><span class="opt__perk"><span class="opt__perk-ck">{% render 'icon', name: 'check' %}</span><span class="opt__perk-ic">{% render 'icon', name: 'shield' %}</span><span><strong>{{ section.settings.perk3b_title }}</strong><small>{{ section.settings.perk3b_sub }}</small></span></span></span>
              {%- endif -%}
              {%- if product.variants.size > 1 -%}
                {%- if forloop.index == 2 -%}<span class="opt__tag">Most popular</span>{%- elsif forloop.last and forloop.index > 2 -%}<span class="opt__tag opt__tag--alt">Best value</span>{%- endif -%}
              {%- endif -%}
            </label>
          {%- endfor -%}
          <div class="buy__row">
            {%- if product.available -%}
            {%- for v in product.variants -%}{%- if v.id == sel_id -%}{%- assign sel_total = v.price -%}{%- endif -%}{%- endfor -%}
            <button type="submit" class="btn btn--lg btn--block">{{ section.settings.cta }} · <span data-atc-total>{{ sel_total | money }}</span></button>
            {%- else -%}<button type="button" class="btn btn--lg btn--block" disabled>Sold out</button>{%- endif -%}
          </div>
          <p class="buy__sub"><span>{% render 'icon', name: 'truck' %} Free shipping over $50</span><span>{% render 'icon', name: 'lock' %} Secure checkout</span><span>{% render 'icon', name: 'shield' %} 60-day guarantee</span></p>
        {%- endform -%}

        <div class="buy__acc">
          {%- for b in section.blocks -%}{%- if b.type == 'accordion' -%}<details {{ b.shopify_attributes }}{% if forloop.first %} open{% endif %}><summary>{{ b.settings.title }}</summary><div class="ans">{{ b.settings.text }}</div></details>{%- endif -%}{%- endfor -%}
          {%- if product.description != blank -%}<details><summary>Full description</summary><div class="ans rte">{{ product.description }}</div></details>{%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>
<div class="sticky" data-sticky>
  <div class="wrap sticky__inner">
    <span class="sticky__t" data-sticky-title data-base="{{ product.title | escape }}">{{ product.title }}</span>
    <span class="sticky__p" data-sticky-price>{{ cur.price | money }}/bottle</span>
    {%- if product.available -%}<button type="button" class="btn">Add to cart</button>{%- endif -%}
  </div>
</div>
{% schema %}
{"name":"Product page","settings":[
 {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Low-dose lithium orotate · 30 vegan capsules"},
 {"type":"textarea","id":"lead","label":"Lead","default":"Five milligrams of lithium, as orotate, and nothing else. One capsule a day for a mood that stays level and a mind that stays sharp.*"},
 {"type":"text","id":"cta","label":"Button text","default":"Add to cart"},
 {"type":"text","id":"sale_label","label":"Sale badge label","default":"Fall sale"},
 {"type":"text","id":"perk_title","label":"3-bottle perk (shown when selected)","default":"FREE Express Shipping ($9.99 Value)"},
 {"type":"text","id":"perk_sub","label":"3-bottle perk subtext","default":"Fast, tracked delivery to your door"},
 {"type":"text","id":"perk3b_title","label":"3-bottle second perk","default":"Extended 90-Day Guarantee"},
 {"type":"text","id":"perk3b_sub","label":"3-bottle second perk subtext","default":"Three full months to decide, or your money back"},
 {"type":"text","id":"perk2_title","label":"2-bottle perk","default":"FREE Shipping ($5.99 Value)"},
 {"type":"text","id":"perk2_sub","label":"2-bottle perk subtext","default":"Your order clears the $50 free-shipping line"},
 {"type":"text","id":"perk2b_title","label":"2-bottle second perk","default":"Price Locked for 60 Days"},
 {"type":"text","id":"perk2b_sub","label":"2-bottle second perk subtext","default":"Reorder at this bundle price for 60 days"},
 {"type":"text","id":"opt_1","label":"Option 1 subtitle","default":"1-month supply"},
 {"type":"text","id":"opt_2","label":"Option 2 subtitle","default":"2-month supply · save more per bottle"},
 {"type":"text","id":"opt_3","label":"Option 3 subtitle","default":"3-month supply · lowest price per capsule"}],
"blocks":[
 {"type":"bullet","name":"Bullet","settings":[{"type":"text","id":"text","label":"Text","default":"5 mg elemental lithium, printed on the front"}]},
 {"type":"accordion","name":"Accordion","settings":[{"type":"text","id":"title","label":"Title","default":"What's inside"},{"type":"textarea","id":"text","label":"Text","default":"Text"}]}],
"presets":[{"name":"Product page","blocks":[
 {"type":"bullet","settings":{"text":"5 mg lithium (as orotate) per capsule, printed on the front"}},
 {"type":"bullet","settings":{"text":"One ingredient. No blend, no fillers padding the label"}},
 {"type":"bullet","settings":{"text":"Vegan capsule, non-GMO, made in the USA"}},
 {"type":"accordion","settings":{"title":"How to take it","text":"One capsule daily with food, ideally breakfast. Trace minerals build slowly: give it a full bottle before deciding. Do not exceed the recommended dose."}},
 {"type":"accordion","settings":{"title":"What's inside","text":"Per capsule: lithium (as orotate) 5 mg. That is the only active ingredient. Other ingredients: vegetable cellulose, microcrystalline cellulose, silica and magnesium stearate. 30 capsules per bottle."}},
 {"type":"accordion","settings":{"title":"Shipping and returns","text":"Ships within one business day from the USA. Free shipping on orders over $50. 60-day money-back guarantee: email us and we refund the bottle, even if it is empty."}},
 {"type":"accordion","settings":{"title":"Who should not take it","text":"Not for use if you are pregnant or nursing, under 18, have kidney or thyroid conditions, or take prescription lithium or other mood medication without speaking to your doctor first."}}]}]}
{% endschema %}
