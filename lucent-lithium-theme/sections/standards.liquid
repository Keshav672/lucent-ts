<section class="sec sec--ink" id="ingredients">
  <div class="wrap">
    <div class="sec__head"><p class="eyebrow" style="color:var(--sky-2)">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.title }}</h2><p class="lead" style="color:rgba(255,255,255,.78)">{{ section.settings.body }}</p></div>
    <div class="stds">
      {%- for b in section.blocks -%}<div class="std" {{ b.shopify_attributes }}><span class="std__k">{{ b.settings.k }}</span><strong>{{ b.settings.title }}</strong><p>{{ b.settings.text }}</p></div>{%- endfor -%}
    </div>
    <div class="ingr">
      <div><h3>Every capsule</h3><ul><li>Lithium (as lithium orotate 120 mg): 5 mg</li><li>Magnesium (as citrate): 100 mg</li><li>Zinc (as citrate): 10 mg</li><li>Vitamin B6 (as P-5-P): 5 mg</li></ul></div>
      <div><h3>And nothing else</h3><p>Vegetable cellulose capsule, rice flour. No gluten, soy, dairy, GMOs, artificial colours or flavours. 60 capsules, 24-month shelf life, made in a cGMP facility in the USA.</p></div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Standards","settings":[
 {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Ultra-pure, low-dose"},
 {"type":"text","id":"title","label":"Heading","default":"Tested like it matters, because it does."},
 {"type":"textarea","id":"body","label":"Body","default":"A trace mineral only helps if the dose on the label is the dose in the capsule. Every batch is tested by an independent lab before it ships."}],
"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"k","label":"Big number","default":"5 mg"},{"type":"text","id":"title","label":"Title","default":"Elemental lithium"},{"type":"textarea","id":"text","label":"Text","default":"The amount used in low-dose research."}]}],
"max_blocks":4,
"presets":[{"name":"Standards","blocks":[
 {"type":"stat","settings":{"k":"5 mg","title":"Elemental lithium","text":"From 120 mg lithium orotate, the amount used in low-dose research. Printed on the front, not buried on the back."}},
 {"type":"stat","settings":{"k":"3rd","title":"Party tested","text":"Identity, potency and heavy metals verified per batch by an independent lab."}},
 {"type":"stat","settings":{"k":"60","title":"Vegan capsules","text":"One a day. Two months per bottle. No fillers, no colours."}},
 {"type":"stat","settings":{"k":"USA","title":"Made in a cGMP facility","text":"Non-GMO, gluten-free, soy-free, dairy-free."}}]}]}
{% endschema %}
