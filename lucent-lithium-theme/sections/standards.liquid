<section class="sec sec--ink" id="ingredients">
  <div class="wrap">
    <div class="sec__head"><p class="eyebrow" style="color:var(--sky-2)">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.title }}</h2><p class="lead" style="color:rgba(255,255,255,.78)">{{ section.settings.body }}</p></div>
    <div class="stds">
      {%- for b in section.blocks -%}<div class="std" {{ b.shopify_attributes }}><span class="std__k">{{ b.settings.k }}</span><strong>{{ b.settings.title }}</strong><p>{{ b.settings.text }}</p></div>{%- endfor -%}
    </div>
    <div class="ingr">
      <div><h3>Every capsule</h3><ul><li>Lithium (as orotate): 5 mg</li><li>Daily value not established</li></ul></div>
      <div><h3>And nothing else</h3><p>Other ingredients: vegetable cellulose, microcrystalline cellulose, silica and magnesium stearate. 60 capsules, 24-month shelf life, made in the USA.</p></div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Standards","settings":[
 {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Ultra-pure, low-dose"},
 {"type":"text","id":"title","label":"Heading","default":"One ingredient. Printed on the front."},
 {"type":"textarea","id":"body","label":"Body","default":"A trace mineral only helps if the dose on the label is the dose in the capsule. Ours is 5 mg of lithium as orotate, and that is the whole active ingredient list."}],
"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"k","label":"Big number","default":"5 mg"},{"type":"text","id":"title","label":"Title","default":"Elemental lithium"},{"type":"textarea","id":"text","label":"Text","default":"The amount used in low-dose research."}]}],
"max_blocks":4,
"presets":[{"name":"Standards","blocks":[
 {"type":"stat","settings":{"k":"5 mg","title":"Elemental lithium","text":"Lithium as orotate, the amount used in low-dose research. Printed on the front, not buried on the back."}},
 {"type":"stat","settings":{"k":"1","title":"Active ingredient","text":"Lithium (as orotate) 5 mg. No blend, no proprietary formula, nothing else to decode."}},
 {"type":"stat","settings":{"k":"60","title":"Vegan capsules","text":"One a day. Two months per bottle. No fillers, no colours."}},
 {"type":"stat","settings":{"k":"USA","title":"Made in the USA","text":"Non-GMO. Vegan capsule."}}]}]}
{% endschema %}
