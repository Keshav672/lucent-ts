<section class="sec sec--cream" id="faq">
  <div class="wrap">
    <div class="sec__head sec__head--center"><h2>{{ section.settings.title }}</h2></div>
    <div class="faq">
      {%- for b in section.blocks -%}<details {{ b.shopify_attributes }}><summary>{{ b.settings.q }}</summary><div class="ans">{{ b.settings.a }}</div></details>{%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"FAQ","settings":[{"type":"text","id":"title","label":"Heading","default":"Questions, answered"}],
"blocks":[{"type":"qa","name":"Question","settings":[{"type":"text","id":"q","label":"Question","default":"Question"},{"type":"textarea","id":"a","label":"Answer","default":"Answer"}]}],
"presets":[{"name":"FAQ","blocks":[
 {"type":"qa","settings":{"q":"Isn't lithium a prescription drug?","a":"Lithium carbonate, the medicine, is prescribed at hundreds of milligrams and monitored with blood tests. Lithium orotate is the same mineral in a trace amount: 5 mg of elemental lithium per capsule, in a form the body absorbs efficiently. It is a dietary supplement, not a medication, and it does not replace one."}},
 {"type":"qa","settings":{"q":"How much should I take, and when?","a":"One capsule a day with food. Most people take it with breakfast. Do not exceed the recommended dose."}},
 {"type":"qa","settings":{"q":"How long until I notice anything?","a":"Trace minerals build gradually. Many customers describe feeling more level somewhere between week two and week six. Give it a full bottle before you decide."}},
 {"type":"qa","settings":{"q":"Can I take it with other supplements or medication?","a":"It combines well with a daily multivitamin or omega-3. If you take prescription medication, especially anything for mood, or you are pregnant or nursing, talk to your healthcare provider before starting."}},
 {"type":"qa","settings":{"q":"Why is there magnesium, zinc and B6 in it?","a":"They are co-factors for the same pathways lithium supports: magnesium for the nervous system, zinc and B6 for neurotransmitter production. Small amounts, chosen to work alongside the lithium rather than pad the label."}},
 {"type":"qa","settings":{"q":"What is your guarantee?","a":"Sixty days, no questions. If you do not feel it is worth it, email us for a full refund, even on an empty bottle."}}]}]}
{% endschema %}
