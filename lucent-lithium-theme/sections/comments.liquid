<section class="sec sec--cream" id="comments">
  <div class="wrap">
    <div class="sec__head"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.title }}</h2><p class="lead">{{ section.settings.body }}</p></div>
    <div class="threads">
      {%- for b in section.blocks -%}
      <article class="thread" {{ b.shopify_attributes }}>
        <div class="cmt">
          <span class="avatar" aria-hidden="true">{{ b.settings.q_name | slice: 0, 1 }}</span>
          <div><p class="cmt__who">{{ b.settings.q_name }}</p><p class="cmt__t">{{ b.settings.q_text }}</p><p class="cmt__meta">{{ b.settings.q_when }} · Reply</p></div>
        </div>
        <div class="cmt cmt--reply">
          <span class="avatar avatar--sm" aria-hidden="true">{{ b.settings.a_name | slice: 0, 1 }}</span>
          <div><p class="cmt__who">{{ b.settings.a_name }} <span class="cmt__badge">Bought it</span></p><p class="cmt__t">{{ b.settings.a_text }}</p><p class="cmt__meta">{{ b.settings.a_when }} · {{ b.settings.a_likes }} likes</p></div>
        </div>
        {%- if b.settings.f_text != blank -%}
        <div class="cmt cmt--reply">
          <span class="avatar avatar--sm" aria-hidden="true">{{ b.settings.q_name | slice: 0, 1 }}</span>
          <div><p class="cmt__who">{{ b.settings.q_name }}</p><p class="cmt__t">{{ b.settings.f_text }}</p><p class="cmt__meta">{{ b.settings.f_when }}</p></div>
        </div>
        {%- endif -%}
      </article>
      {%- endfor -%}
    </div>
    <p class="muted" style="font-size:13px;margin-top:20px">{{ section.settings.note }}</p>
  </div>
</section>
{% schema %}
{"name":"Ad comments","settings":[
 {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Straight from the ad comments"},
 {"type":"text","id":"title","label":"Heading","default":"Don't take our word for it. Ask the comments."},
 {"type":"textarea","id":"body","label":"Body","default":"Every time someone asks “isn't lithium dangerous?” or “does this actually do anything?” under our ads, the answers come from people who already tried it."},
 {"type":"text","id":"note","label":"Footnote","default":"Comments are lightly edited for length. Individual results vary."}],
"blocks":[{"type":"thread","name":"Thread","settings":[
 {"type":"text","id":"q_name","label":"Asker name","default":"Dana K."},
 {"type":"textarea","id":"q_text","label":"Question","default":"Does this actually work?"},
 {"type":"text","id":"q_when","label":"Question time","default":"2w"},
 {"type":"text","id":"a_name","label":"Answerer name","default":"Marcus D."},
 {"type":"textarea","id":"a_text","label":"Answer","default":"It does."},
 {"type":"text","id":"a_when","label":"Answer time","default":"2w"},
 {"type":"text","id":"a_likes","label":"Likes","default":"14"},
 {"type":"textarea","id":"f_text","label":"Follow-up from asker (optional)","default":""},
 {"type":"text","id":"f_when","label":"Follow-up time","default":"1w"}]}],
"presets":[{"name":"Ad comments","blocks":[
 {"type":"thread","settings":{"q_name":"Dana K.","q_text":"Isn't lithium the thing they give people in hospitals?? How is this safe to just buy online","q_when":"3w","a_name":"Marcus D.","a_text":"Different thing. The hospital drug is lithium carbonate at 300 to 900 mg with blood tests. This is 5 mg of the mineral as orotate. I was nervous too, read up on it for a month before ordering. Two bottles in now.","a_when":"3w","a_likes":"41","f_text":"ok update: ordered after this. week 3 and my husband asked what changed. nothing changed, I just stopped snapping.","f_when":"1w"}},
 {"type":"thread","settings":{"q_name":"Priya S.","q_text":"Does this actually do anything or is it placebo? Honest answers pls","q_when":"2w","a_name":"Renee T.","a_text":"Honest answer: nothing for the first two weeks. Around week three I noticed I hadn't had a Sunday night spiral in a while. It's not a switch, it's a floor.","a_when":"2w","a_likes":"27","f_text":"","f_when":""}},
 {"type":"thread","settings":{"q_name":"Tom H.","q_text":"Why this one and not the $9 bottle on Amazon?","q_when":"1w","a_name":"Jess A.","a_text":"Because the $9 one says 120 mg and never tells you how much is actually lithium. This one prints the actual lithium amount, 5 mg, on the front. That's the whole reason I switched.","a_when":"1w","a_likes":"19","f_text":"","f_when":""}}]}]}
{% endschema %}
