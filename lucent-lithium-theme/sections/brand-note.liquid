<section class="sec">
  <div class="wrap note">
    <div class="note__media">
      {%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" width="900" height="1100" loading="lazy">
      {%- else -%}<div class="note__fallback"><img src="{{ 'bottle-white.jpg' | asset_url }}" alt="Lucent Lithium Orotate bottle" width="900" height="930" loading="lazy"><span class="note__cap">{{ section.settings.mono }}</span></div>{%- endif -%}
    </div>
    <div class="note__copy">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.title }}</h2>
      <div class="note__body">{{ section.settings.body }}</div>
      <p class="note__sign">{{ section.settings.sign }}</p>
    </div>
  </div>
</section>
{% schema %}
{"name":"Note from the brand","settings":[
 {"type":"image_picker","id":"image","label":"Photo (founder, team or bottle in your kitchen)"},
 {"type":"text","id":"mono","label":"Caption on the fallback bottle image","default":"Made in the USA · Tested every batch · 5 mg on the front"},
 {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Who you're buying from"},
 {"type":"text","id":"title","label":"Heading","default":"We put the dose on the front because we were tired of guessing too."},
 {"type":"richtext","id":"body","label":"Body","default":"<p>Lucent started with one frustration: every lithium orotate bottle said 120 mg and none of them told you how much lithium that actually was. So we made one that does. 5 mg elemental, printed on the front, tested by an outside lab every batch.</p><p>We are a small team. We answer our own emails. If a bottle doesn't do what we say, we refund it, and we'd rather hear about it than not.</p>"},
 {"type":"text","id":"sign","label":"Sign-off","default":"— The Lucent team"}],
"presets":[{"name":"Note from the brand"}]}
{% endschema %}
